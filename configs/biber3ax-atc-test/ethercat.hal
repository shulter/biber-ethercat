# Vantage 33M ATC test config — single-motor X (no gantry, bench test mode)
# + Y + Z via EtherCAT, plus a HSK63F ATC / drill / tool-height-probe
# toolchanger (see README.md and remap/).
# Requires: lcec, cia402 HAL components
#
# num_dio=16 gives the M6/M106 remaps (see remap/) 16 motion.digital-out-NN
# pins for the drill solenoids + spindle drawbar, wired in io.hal.

loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS num_dio=16

loadusr -W lcec_conf ethercat-conf.xml
loadrt lcec
loadrt cia402 count=3

addf lcec.read-all            servo-thread
addf cia402.0.read-all        servo-thread
addf cia402.1.read-all        servo-thread
addf cia402.2.read-all        servo-thread
addf motion-command-handler   servo-thread
addf motion-controller      servo-thread
addf cia402.0.write-all       servo-thread
addf cia402.1.write-all       servo-thread
addf cia402.2.write-all       servo-thread
addf lcec.write-all           servo-thread

# Gate machine-enable on the EtherCAT master actually reaching OP state for
# all configured slaves. Previously this was `setp ... 1` (always true), so
# "Machine On" would succeed even with slaves stuck in INIT/PREOP/SAFEOP —
# cia402 would then be driven from stale/zero PDO data. lcec.0.state-op is a
# live bit, so this also drops the machine (like a fault) if a slave falls
# out of OP later, not just at startup.
# TODO verify pin name/semantics against your lcec version:
#   halcmd show pin | grep lcec.0.state
net ec-all-op <= lcec.0.state-op => iocontrol.0.emc-enable-in

# --- X axis (single motor, joint 0) ---
setp cia402.0.csp-mode 1
setp cia402.0.pos-scale [JOINT_0]CIA402_POS_SCALE

net x-enable     <= joint.0.amp-enable-out => cia402.0.enable
net x-amp-fault  => joint.0.amp-fault-in   <= cia402.0.drv-fault
net x-pos-cmd    <= joint.0.motor-pos-cmd  => cia402.0.pos-cmd
net x-pos-fb     => joint.0.motor-pos-fb   <= cia402.0.pos-fb

net x-statusword     lcec.0.x.status-word      => cia402.0.statusword
net x-opmode-display lcec.0.x.mode-display     => cia402.0.opmode-display
net x-drv-act-pos    lcec.0.x.actual-position  => cia402.0.drv-actual-position
net x-drv-act-vel    lcec.0.x.actual-velocity  => cia402.0.drv-actual-velocity

net x-controlword    cia402.0.controlword           => lcec.0.x.control-word
net x-opmode         cia402.0.opmode                => lcec.0.x.control-mode
net x-drv-target-pos cia402.0.drv-target-position   => lcec.0.x.target-position
net x-drv-target-vel cia402.0.drv-target-velocity   => lcec.0.x.target-velocity

net x-home-sw => joint.0.home-sw-in <= lcec.0.x.home-switch

# --- Y axis (single motor, ball screw via belt reduction) ---
setp cia402.1.csp-mode 1
setp cia402.1.pos-scale [JOINT_1]CIA402_POS_SCALE

net y-enable     <= joint.1.amp-enable-out => cia402.1.enable
net y-amp-fault  => joint.1.amp-fault-in   <= cia402.1.drv-fault
net y-pos-cmd    <= joint.1.motor-pos-cmd  => cia402.1.pos-cmd
net y-pos-fb     => joint.1.motor-pos-fb   <= cia402.1.pos-fb

net y-statusword     lcec.0.y.status-word      => cia402.1.statusword
net y-opmode-display lcec.0.y.mode-display     => cia402.1.opmode-display
net y-drv-act-pos    lcec.0.y.actual-position  => cia402.1.drv-actual-position
net y-drv-act-vel    lcec.0.y.actual-velocity  => cia402.1.drv-actual-velocity

net y-controlword    cia402.1.controlword           => lcec.0.y.control-word
net y-opmode         cia402.1.opmode                => lcec.0.y.control-mode
net y-drv-target-pos cia402.1.drv-target-position   => lcec.0.y.target-position
net y-drv-target-vel cia402.1.drv-target-velocity   => lcec.0.y.target-velocity

net y-home-sw => joint.1.home-sw-in <= lcec.0.y.home-switch

# --- Z axis (direct ball screw) ---
setp cia402.2.csp-mode 1
setp cia402.2.pos-scale [JOINT_2]CIA402_POS_SCALE

net z-enable     <= joint.2.amp-enable-out => cia402.2.enable
net z-amp-fault  => joint.2.amp-fault-in   <= cia402.2.drv-fault
net z-pos-cmd    <= joint.2.motor-pos-cmd  => cia402.2.pos-cmd
net z-pos-fb     => joint.2.motor-pos-fb   <= cia402.2.pos-fb

net z-statusword     lcec.0.z.status-word      => cia402.2.statusword
net z-opmode-display lcec.0.z.mode-display     => cia402.2.opmode-display
net z-drv-act-pos    lcec.0.z.actual-position  => cia402.2.drv-actual-position
net z-drv-act-vel    lcec.0.z.actual-velocity  => cia402.2.drv-actual-velocity

net z-controlword    cia402.2.controlword           => lcec.0.z.control-word
net z-opmode         cia402.2.opmode                => lcec.0.z.control-mode
net z-drv-target-pos cia402.2.drv-target-position   => lcec.0.z.target-position
net z-drv-target-vel cia402.2.drv-target-velocity   => lcec.0.z.target-velocity

net z-home-sw => joint.2.home-sw-in <= lcec.0.z.home-switch
