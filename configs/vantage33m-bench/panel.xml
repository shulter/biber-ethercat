<?xml version="1.0" encoding="UTF-8"?>
<!--
  Vantage 33M bench config — PyVCP panel. AXIS renders this in the pane to
  the right of the g-code preview automatically (see [DISPLAY] PYVCP in
  vantage33m-bench.ini) — no separate tab, no embedding setup needed.

  Shows live servo torque for the 3 bench servos: a bidirectional bar graph
  (-10 to 0 to +10 Nm) plus a numeric readout for each. See postgui.hal for
  the HAL wiring.

  Written by hand, not exported from a PyVCP designer. Tag names (bar, min_,
  max_, halpin, text, number, format) confirmed working against a real
  AXIS/PyVCP. With min_ negative and max_ positive, PyVCP's stock bar widget
  is assumed to fill from a center zero line — red toward min_, green toward
  max_ — matching the red=negative/green=positive convention used elsewhere
  in AXIS. If it doesn't color that way in practice, say so and this can be
  redone as two stacked bars (a green 0..+10 bar fed by max(torque,0) and a
  red 0..+10 bar fed by -min(torque,0)) instead.
-->
<pyvcp>

<labelframe text="Servo Torque">
<vbox>

<label>
  <text>"X Left Torque (Nm)"</text>
</label>
<bar>
  <halpin>"x-left-torque"</halpin>
  <min_>-10</min_>
  <max_>10</max_>
</bar>
<number>
  <halpin>"x-left-torque-num"</halpin>
  <format>"6.2f Nm"</format>
</number>

<label>
  <text>"X Right Torque (Nm)"</text>
</label>
<bar>
  <halpin>"x-right-torque"</halpin>
  <min_>-10</min_>
  <max_>10</max_>
</bar>
<number>
  <halpin>"x-right-torque-num"</halpin>
  <format>"6.2f Nm"</format>
</number>

<label>
  <text>"Y Torque (Nm)"</text>
</label>
<bar>
  <halpin>"y-torque"</halpin>
  <min_>-10</min_>
  <max_>10</max_>
</bar>
<number>
  <halpin>"y-torque-num"</halpin>
  <format>"6.2f Nm"</format>
</number>

</vbox>
</labelframe>

</pyvcp>
