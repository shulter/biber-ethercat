# Vantage 33M final config — Beckhoff EK1100 + terminal chain wiring
# (loaded after ethercat.hal, see [HAL] HALFILE in biber3ax.ini)
#
# EtherCAT chain order (see ethercat-conf.xml), after the 4 servo drives
# (x-left, x-right, y, z):
#   EK1100 -> EL1808 -> EL1808 -> EL1808 -> EL1808 -> EL2808 -> EL2808 -> EL1018
#          -> EL9110 -> EL2808 -> EL2808 -> EL4032
#
# Each EL1808 is 8 digital inputs (din-0..din-7, 3ms filter), the EL1018 is 8
# digital inputs (din-0..din-7, 10us — no input filtering, for fast signals
# like probe/index), each EL2808 is 8 digital outputs (dout-0..dout-7). Net
# names are placeholders — assign to actual machine signals (e-stop chain,
# door interlocks, vacuum, dust, tool change — see docs/retrofit-plan.md
# Phase 4) once wiring is known, except dout1-0 below which is wired to the
# machine-enable indicator.

# --- EL1808 #1 (digital inputs, slave idx 5) ---
net io-din1-0 <= lcec.0.io-din1.din-0   # pendant button for main spindle tool release (NO, TRUE = pressed) — see drawbar-release below
# net io-din1-1 <= lcec.0.io-din1.din-1   # pendant button for reset
net io-din1-2 <= lcec.0.io-din1.din-2   # footswitch right — toggles vacuum pump
net io-din1-3 <= lcec.0.io-din1.din-3   # footswitch left — toggles all reg pins up / down
net io-din1-4 <= lcec.0.io-din1.din-4   # pendant button negative jog — see pendant jog below
net io-din1-5 <= lcec.0.io-din1.din-5   # pendant button positive jog — see pendant jog below
# net io-din1-6 <= lcec.0.io-din1.din-6   # pendant button F1 TBD
# net io-din1-7 <= lcec.0.io-din1.din-7   # pendant button F2 TBD

# --- EL1808 #2 (digital inputs, slave idx 6) ---
# net io-din2-0 <= lcec.0.io-din2.din-0   # VFD not turning
net io-din2-1 <= lcec.0.io-din2.din-1   # VFD spindle at speed (TRUE = at speed) — see spindle at-speed wait below
net io-din2-2 <= lcec.0.io-din2.din-2   # HSK main spindle: tool present and clamped (drawbar up without tool: FALSE) — see spindle interlock below
net io-din2-3 <= lcec.0.io-din2.din-3   # HSK main spindle: tool released / drawbar down (TRUE = released) — see spindle interlock below
net io-din2-4 <= lcec.0.io-din2.din-4   # HSK spindle: not turning (back EMF measurement, TRUE = not turning) — see drawbar-release below
net io-din2-5 <= lcec.0.io-din2.din-5   # X horizontal drill aggregate is up (TRUE = up) — tool change
net io-din2-6 <= lcec.0.io-din2.din-6   # Y horizontal drill aggregate is up (TRUE = up) — tool change
net io-din2-7 <= lcec.0.io-din2.din-7   # vacuum sensor, pressure ok (TRUE = ok) — panel LED only

# --- EL1808 #3 (digital inputs, slave idx 7) ---
net io-din3-0 <= lcec.0.io-din3.din-0   # Pneumatic air sensor, pressure ok (TRUE = ok) — tool change
# net io-din3-1 <= lcec.0.io-din3.din-1   # Dust hood is at position 1
# net io-din3-2 <= lcec.0.io-din3.din-2   # Dust hood is at position 2
net io-din3-3 <= lcec.0.io-din3.din-3   # reg pin Y0L down (TRUE = down, out of the way) — panel LED
net io-din3-4 <= lcec.0.io-din3.din-4   # reg pin Y1R down
net io-din3-5 <= lcec.0.io-din3.din-5   # reg pin Y1L down
net io-din3-6 <= lcec.0.io-din3.din-6   # reg pin R down
net io-din3-7 <= lcec.0.io-din3.din-7   # reg pin Y0R down

# --- EL1808 #4 (digital inputs, slave idx 8) ---
net io-din4-0 <= lcec.0.io-din4.din-0   # pendant axis select dial, grey-code bit 0 — see pendant jog below
net io-din4-1 <= lcec.0.io-din4.din-1   # pendant axis select dial, grey-code bit 1
net io-din4-2 <= lcec.0.io-din4.din-2   # pendant axis select dial, grey-code bit 2
net io-din4-3 <= lcec.0.io-din4.din-3   # pendant axis select dial, grey-code bit 3
net io-din4-4 <= lcec.0.io-din4.din-4   # reg pin L down
# net io-din4-5 <= lcec.0.io-din4.din-5   # TODO: assign
# net io-din4-6 <= lcec.0.io-din4.din-6   # TODO: assign
# net io-din4-7 <= lcec.0.io-din4.din-7   # TODO: assign

# --- EL2808 #1 (digital outputs, slave idx 9) ---
# dout-0: machine-enable indicator — energized while LinuxCNC is switched on
# (halui.machine.is-on). Drives an external "machine enabled" lamp/relay;
# it is not the interlock chain feeding iocontrol.0.emc-enable-in.
net machine-enable <= halui.machine.is-on => lcec.0.io-dout1.dout-0 # Machine Enable

# dout-1: Z axis holding brake. TRUE = brake coil energized = brake released.
# Released 1.3 s after Z's amp-enable-out goes true (machine on, F2), giving
# the servo time to power up and hold position first; engaged again
# immediately (off-delay 0) when the machine is switched off or faults.
# z-brake-delay is loaded with the other timedelay instances in ethercat.hal.
# Note: the drive-ready supervision (ethercat.hal) faults the machine off if
# the Z drive isn't operation-enabled within its on-delay (< 1.3 s), so the
# brake only ever releases on a drive that's already holding.
addf z-brake-delay servo-thread
setp z-brake-delay.on-delay  1.3
setp z-brake-delay.off-delay 0.0
net z-enable => z-brake-delay.in
net z-brake-release <= z-brake-delay.out => lcec.0.io-dout1.dout-1 # Z brake release

# dout-2 / dout-3: VFD output contactors. The single KEB VFD feeds either the
# boring aggregate motor (dout-2) or the HSK milling spindle (dout-3) through
# its own contactor. M6 selects the motor on motion.digital-out-10 (boring),
# only while the spindle is stopped:
#   T1..T100   HSK milling spindle            -> dout-3
#   T101..T107 vertical boring spindles 1-7   -> dout-2
#   T201..T204 horizontal boring head         -> dout-2
# The selected contactor is closed whenever the machine is on (machine-enable).
# lut5 (loaded in ethercat.hal), in-0 = spindle-contactor, in-1 = boring:
#   hsk-contactor-gate    in-0 AND NOT in-1 -> index 1 -> 0x2
#   boring-contactor-gate in-0 AND in-1     -> index 3 -> 0x8
# The contactor opens only 10 s after machine-enable drops (machine off, F2 or
# e-stop): machine off stops the spindle (spindle.0.forward/reverse drop — verify
# with halcmd when commissioning), and the KEB needs
# its motor connected to ramp the spindle down — opening the contactor under a
# spinning motor leaves it coasting and can damage the VFD. Keep the KEB's
# deceleration time below this off-delay.
# spindle-contactor-delay is loaded with the other timedelay instances in
# ethercat.hal.
addf spindle-contactor-delay servo-thread
setp spindle-contactor-delay.on-delay  0.0
setp spindle-contactor-delay.off-delay 10.0
addf hsk-contactor-gate    servo-thread
addf boring-contactor-gate servo-thread
setp hsk-contactor-gate.function    0x2
setp boring-contactor-gate.function 0x8
net machine-enable => spindle-contactor-delay.in
net spindle-contactor <= spindle-contactor-delay.out => hsk-contactor-gate.in-0 boring-contactor-gate.in-0
net boring-select     <= motion.digital-out-10       => hsk-contactor-gate.in-1 boring-contactor-gate.in-1
net boring-contactor  <= boring-contactor-gate.out => lcec.0.io-dout1.dout-2   # Drill Aggregate Enable Contactor
net hsk-contactor     <= hsk-contactor-gate.out    => lcec.0.io-dout1.dout-3   # HSK Milling Spindle Enable Contactor
# dout-4: vacuum pump contactor — wired with the vacuum table below.
# dout-5 / dout-6: KEB parameter set select (KEB inputs I1 / I4, per
# D/KEB/F5_SKF9KW.dw5 in the original TwinCAT backup). One must be on for the
# connected motor; with none active the KEB falls back to set 0 (stop set for
# misuse/blocked motor) and the spindle won't run.
#   I1 (dout-5) -> set 2: boring aggregate motor, 50 Hz
#   I4 (dout-6) -> set 5: HSK SKF spindle with milling tool, 400 Hz
# Each set input follows its motor's contactor (on with machine-enable, off
# 10 s later) so the KEB keeps the set while it ramps the motor down.
net boring-contactor => lcec.0.io-dout1.dout-5   # KEB I1: parameter set 2, boring aggregate
net hsk-contactor    => lcec.0.io-dout1.dout-6   # KEB I4: parameter set 5, HSK milling spindle
# HSK spindle flange flush air (33Y7 Abblasdüse): M6 (motion.digital-out-07) OR
# a 0.1 s pulse when the pendant release button is let go (tool clamps).
# (edge can only be loadrt'd once: foot-left-edge / program-start-edge are
# the reg pins' instances, see io-dout3 below.)
loadrt edge names=clamp-flush-pulse,foot-left-edge,program-start-edge
addf clamp-flush-pulse servo-thread
addf tc-flush-or       servo-thread
setp clamp-flush-pulse.in-edge      0           # falling edge
setp clamp-flush-pulse.out-width-ns 100000000   # 0.1 s
net io-din1-0      => clamp-flush-pulse.in
net clamp-flush    <= clamp-flush-pulse.out       => tc-flush-or.in1
net tc-flush-req   <= motion.digital-out-07       => tc-flush-or.in0
net tc-flush-air   <= tc-flush-or.out             => lcec.0.io-dout1.dout-7
# Blow nozzle next to the spindle (33Y6 Blasdüse; workpiece, tool probe):
# M210 (motion.digital-out-22) OR the panel button (postgui.hal).
addf blow-nozzle-or servo-thread
net blow-nozzle-req <= motion.digital-out-22      => blow-nozzle-or.in0
net blow-nozzle     <= blow-nozzle-or.out         => lcec.0.io-dout3.dout-4

# --- EL2808 #2 (digital outputs, slave idx 10) ---
# dout-0 / dout-1: X rack oiler — per 30 min of X movement (original TwinCAT:
# 25 min) a 0.6 s pulse on the air-driven grease pump, 1 s pause, then 10 s
# blow air pushes the dose through the line onto the rack (as the original).
# M270 (remap/m270.ngc) starts the cycle by hand via motion.digital-out-21.
# X moves while |joint.0.vel-cmd| >= 0.1 mm/s; integ sums the moving seconds.
# Not persistent: restarts at 0 with LinuxCNC.
loadrt wcomp          names=x-still
loadrt conv_bit_float names=x-moving-float
loadrt integ          names=x-oil-time
loadrt comp           names=x-oil-due
loadrt oneshot        names=x-oil-pulse,x-oil-pause,x-oil-air
addf x-still        servo-thread
addf x-moving       servo-thread
addf x-moving-float servo-thread
addf x-oil-time     servo-thread
addf x-oil-due      servo-thread
addf x-oil-start    servo-thread
addf x-oil-pulse    servo-thread
addf x-oil-pause    servo-thread
addf x-oil-air      servo-thread
setp x-still.min      -0.1
setp x-still.max       0.1
setp x-oil-due.in0      1800.0
setp x-oil-pulse.width  0.6
setp x-oil-pause.width  1.0
setp x-oil-air.width   10.0
setp x-oil-pause.rising  0   # both start on the falling edge of the previous step
setp x-oil-pause.falling 1
setp x-oil-air.rising    0
setp x-oil-air.falling   1
net x-vel-cmd     <= joint.0.vel-cmd    => x-still.in
net x-vel-under   <= x-still.under      => x-moving.in0
net x-vel-over    <= x-still.over       => x-moving.in1
net x-moving      <= x-moving.out       => x-moving-float.in
net x-moving-time <= x-moving-float.out => x-oil-time.in
net x-oil-time    <= x-oil-time.out     => x-oil-due.in1
net x-oil-due     <= x-oil-due.out      => x-oil-start.in0
net x-oil-req     <= motion.digital-out-21 => x-oil-start.in1
net x-oil-start   <= x-oil-start.out    => x-oil-pulse.in
net x-oil         <= x-oil-pulse.out    => x-oil-time.reset x-oil-pause.in lcec.0.io-dout2.dout-0   # oil dispenser X axis rack and pinion
net x-oil-pause   <= x-oil-pause.out    => x-oil-air.in
net x-oil-air     <= x-oil-air.out      => lcec.0.io-dout2.dout-1   # Schmierung Blasluft
# dout-2 / dout-3: VFD CW / CCW — wired after the spindle start interlock below.
# Vacuum table (remap/m240..m243.ngc), via motion digital outputs:
#   out-04 -> io-dout1-4 pump, out-05 -> dout2-4 left gate open,
#   out-06 -> dout2-6 right gate open.
#   M241 / M240 pump on / off, M242 / M243 [P0] left / right gate open [close].
# The pump state is held in a flipflop (like the dust hood): M241 pulses
# out-04 onto set, M240 pulses out-20 onto reset, the right foot switch or the
# PyVCP button (postgui.hal) toggles it. Machine off doesn't stop the pump.
# lut5 vacuum-pump-toggle (loaded in ethercat.hal): in-0 OR in-1 OR in-2 -> 0xFE, onto clk
# (in-1 unused: the left foot switch toggles the reg pins).
# Each port has separate open / close valves. The close valve (dout2-5 left,
# dout2-7 right) is driven by the inverse of the open request (not
# components), so exactly one of each pair is energised — both ports are
# closed from the moment HAL starts.
# ("not" can only be loadrt'd once per HAL session, so the spindle-turning
# instance for the PyVCP indicator — see the HSK spindle section below — is
# loaded here too.)
loadrt not names=vacuum-left-close,vacuum-right-close,spindle-turning
addf vacuum-left-close  servo-thread
addf vacuum-right-close servo-thread
addf spindle-turning    servo-thread
net vacuum-left-open    <= motion.digital-out-05 => lcec.0.io-dout2.dout-4 vacuum-left-close.in    # vaccuum port left open
net vacuum-left-closed  <= vacuum-left-close.out => lcec.0.io-dout2.dout-5                         # vaccuum port left close
net vacuum-right-open   <= motion.digital-out-06 => lcec.0.io-dout2.dout-6 vacuum-right-close.in   # vaccuum port right open
net vacuum-right-closed <= vacuum-right-close.out => lcec.0.io-dout2.dout-7                        # vaccuum port right close

loadrt flipflop names=vacuum-pump,dust-hood,reg-pins-left,reg-pins-right   # dust-hood, reg-pins-*: see io-dout3 below
addf vacuum-pump-toggle servo-thread
addf vacuum-pump     servo-thread
setp vacuum-pump-toggle.function 0xFE
net vacuum-pump-off-req <= motion.digital-out-20 => vacuum-pump.reset
net vacuum-pump-on-req  <= motion.digital-out-04 => vacuum-pump.set
net vacuum-pump-on      <= vacuum-pump.out       => lcec.0.io-dout1.dout-4   # Vacuum pump Enable Contactor
net vacuum-pump-is-off  <= vacuum-pump.out-not   => vacuum-pump.data
net io-din1-2                                    => vacuum-pump-toggle.in-0
net vacuum-pump-clk     <= vacuum-pump-toggle.out => vacuum-pump.clk

# --- EL1018 (fast digital inputs, 10us, slave idx 11) ---
net tool-probe <= lcec.0.io-din5.din-0-not => motion.probe-input   # Tool height probe (M210), TRUE = triggered (NC)

# Limit switches, din-1..din-4. Each axis homes onto one of its limit
# switches, which doubles as the home switch (HOME_IGNORE_LIMITS = YES in the
# INI): X and Z+ at the positive end (search +), Y at the Y0 / negative end
# (search -). X has one switch for the whole gantry, netted to both X joints
# (tandem homing, HOME_SEQUENCE -2). X has only a positive limit switch, Y
# only a negative one.
#
# Switch polarity (joint pins expect TRUE = tripped):
# - X is normally-closed — din is TRUE while the axis is clear, so it uses
#   lcec's built-in inverted pin din-1-not.
# - Y, Z+ and Z- are normally-open — din goes TRUE only when hit, so they're
#   netted straight to the joint pins.
# Check: with the machine clear of all switches, `halcmd show pin
# lcec.0.io-din5` should read din-1 TRUE and din-2..din-4 FALSE.
net x-pos-lim <= lcec.0.io-din5.din-1-not => joint.0.pos-lim-sw-in joint.0.home-sw-in   # X positive limit / home (NC)
net x-pos-lim                             => joint.1.pos-lim-sw-in joint.1.home-sw-in
net y-neg-lim <= lcec.0.io-din5.din-2 => joint.2.neg-lim-sw-in joint.2.home-sw-in   # Y negative limit (Y0 end) / home (NO)
net z-pos-lim <= lcec.0.io-din5.din-3 => joint.3.pos-lim-sw-in joint.3.home-sw-in   # Z positive limit / home (NO)
net z-neg-lim <= lcec.0.io-din5.din-4 => joint.3.neg-lim-sw-in                      # Z negative limit (NO)

# net io-din5-5 <= lcec.0.io-din5.din-5   # TODO: assign
# net io-din5-6 <= lcec.0.io-din5.din-6   # TODO: assign
# net io-din5-7 <= lcec.0.io-din5.din-7   # TODO: assign

# --- EL9110 (E-bus power supply feed terminal, bus position 12) ---
# Refreshes E-bus power for the terminals downstream of it in the chain.
# Declared in ethercat-conf.xml as a generic slave (so it reaches OP and
# lcec.0.state-op can go true — see the comment there). Its single input,
# lcec.0.io-power.power-ok, reports 24V supply OK; not wired to anything yet.
# net io-power-ok <= lcec.0.io-power.power-ok

# --- EL2808 #3 (digital outputs, slave idx 13) ---
# dout-0 / dout-5: reg pins left / right side — TRUE = pins up. Each side is
# held in a flipflop (starts down):
# - M231 / M232 (remap/m231.ngc, m232.ngc) raise left / right: pulse
#   motion.digital-out-03 / -23 onto set. M230 lowers both: out-24 onto reset.
# - Left foot switch (io-din1-3, rising edge): all down if any side is up,
#   else all up.
# lut5, in-0 = foot edge, in-1 = left up, in-2 = right up, in-3 = M-code pulse:
#   reg-left-set / reg-right-set  in-3 OR (in-0 AND NOT in-1 AND NOT in-2) -> 0xFF02
#   reg-pins-down                 in-3 OR (in-0 AND (in-1 OR in-2))         -> 0xFFA8
addf foot-left-edge  servo-thread
addf reg-left-set    servo-thread
addf reg-right-set   servo-thread
addf reg-pins-down   servo-thread
addf reg-pins-left   servo-thread
addf reg-pins-right  servo-thread
setp foot-left-edge.in-edge    1
setp reg-left-set.function     0xFF02
setp reg-right-set.function    0xFF02
setp reg-pins-down.function    0xFFA8
net io-din1-3                                    => foot-left-edge.in
net foot-left-press    <= foot-left-edge.out     => reg-left-set.in-0 reg-right-set.in-0 reg-pins-down.in-0
net reg-left-up-req    <= motion.digital-out-03  => reg-left-set.in-3
net reg-right-up-req   <= motion.digital-out-23  => reg-right-set.in-3
net reg-pins-down-req  <= motion.digital-out-24  => reg-pins-down.in-3
net reg-left-set-out   <= reg-left-set.out       => reg-pins-left.set
net reg-right-set-out  <= reg-right-set.out      => reg-pins-right.set
net reg-pins-down-out  <= reg-pins-down.out      => reg-pins-left.reset reg-pins-right.reset
net reg-pins-left-up   <= reg-pins-left.out      => lcec.0.io-dout3.dout-0 reg-left-set.in-1 reg-right-set.in-1 reg-pins-down.in-1   # Reg pins left side up
net reg-pins-right-up  <= reg-pins-right.out     => lcec.0.io-dout3.dout-5 reg-left-set.in-2 reg-right-set.in-2 reg-pins-down.in-2   # Reg pins right side up

# Program start with reg pins up: pause and warn. Start = interpreter leaves
# idle in AUTO mode (falling edge of halui.program.is-idle, 0.1 s pulse so
# halui sees it); up = any of the six "down" sensors FALSE.
# lut5 reg-pins-not-down: NOT all of in-0..4 (din3-3..7) -> 0x7FFFFFFF
# lut5 reg-pins-start-check: in-0 start AND in-1 auto AND (in-2 OR NOT in-3 (din4-4)) -> 0x8088
loadrt message names=reg-pins-up-msg messages="Reg pins are up - program paused. Lower them (M230 or left foot switch) then resume."
addf program-start-edge   servo-thread
addf reg-pins-not-down    servo-thread
addf reg-pins-start-check servo-thread
addf reg-pins-up-msg      servo-thread
setp program-start-edge.in-edge      0
setp program-start-edge.out-width-ns 100000000
setp reg-pins-not-down.function    0x7FFFFFFF
setp reg-pins-start-check.function 0x8088
net program-idle     <= halui.program.is-idle   => program-start-edge.in
net program-start    <= program-start-edge.out  => reg-pins-start-check.in-0
net mode-auto        <= halui.mode.is-auto      => reg-pins-start-check.in-1
net io-din3-3        => reg-pins-not-down.in-0
net io-din3-4        => reg-pins-not-down.in-1
net io-din3-5        => reg-pins-not-down.in-2
net io-din3-6        => reg-pins-not-down.in-3
net io-din3-7        => reg-pins-not-down.in-4
net reg-pins-not-down-1to5 <= reg-pins-not-down.out => reg-pins-start-check.in-2
net io-din4-4        => reg-pins-start-check.in-3
net reg-pins-up-at-start   <= reg-pins-start-check.out => halui.program.pause reg-pins-up-msg.trigger

# dout-1: HSK spindle drawbar — TRUE pushes the drawbar and releases the tool.
# Interlocked in HAL (lut5 drawbar-release, loaded in ethercat.hal):
#
#   release = (pendant button OR M250 request)
#             AND spindle not turning (din2-4)  AND NOT spindle.0.on
#
# - Pendant button (io-din1-0): release only while held.
# - M250 / M251 (remap/m250.ngc, m251.ngc): set / clear the release request
#   on motion.digital-out-00 (M64/M65 P0). M250 checks the same conditions
#   itself first and aborts the program if they aren't met; the HAL interlock
#   above enforces them again, and drops the release if the spindle is
#   switched on or starts turning.
# - M250 reads spindle state through motion.digital-in-00 (not turning) and
#   motion.digital-in-01 (spindle.0.on) with M66.
# lut5 index = in-0 + 2*in-1 + 4*in-2 + 8*in-3; true for in-3=0, in-2=1 and
# (in-0 or in-1) → indexes 5, 6, 7 → function 0xE0.
addf drawbar-release servo-thread
setp drawbar-release.function 0xE0
net io-din1-0             => drawbar-release.in-0
net drawbar-release-req   <= motion.digital-out-00 => drawbar-release.in-1
net io-din2-4             => drawbar-release.in-2 motion.digital-in-00
net spindle-on            => drawbar-release.in-3 motion.digital-in-01
net drawbar-release-out   <= drawbar-release.out   => lcec.0.io-dout3.dout-1   # HSK Spindle pull draw bar up, release tool

# "Spindle turning" for the PyVCP panel LED (netted to pyvcp in postgui.hal):
# inverse of the back-EMF "not turning" input din2-4.
net io-din2-4         => spindle-turning.in
net spindle-turning   <= spindle-turning.out

# Spindle start interlock: the spindle may only run with a tool present and clamped.
#
#   tool-clamped = din2-2 (clamped) AND NOT din2-3 (released)
#                  AND NOT drawbar release output
#
# - spindle.0.inhibit = NOT tool-clamped: motion holds the spindle speed at 0,
#   so the spindle can't turn without a clamped tool.
# - spindle.0.amp-fault-in = spindle.0.on AND NOT tool-clamped: commanding the
#   spindle on (M3/M4, AXIS spindle button) without a clamped tool raises a
#   spindle amplifier fault, which switches the machine off and aborts a
#   running program instead of letting it cut with a stopped spindle.
# Both switches must agree (clamped TRUE, released FALSE), so a stuck or
# broken switch also blocks the spindle.
# lut5 index = in-0 + 2*in-1 + 4*in-2 + 8*in-3. tool-clamped is only
# index 1 (in-0=1, in-1=0, in-2=0):
#   spindle-inhibit    (in-0..2):  NOT clamped            → ~0x02 & 0xFF = 0xFD
#   spindle-tool-fault (in-0..3):  in-3 AND NOT clamped   → 0xFF00 & ~(1<<9) = 0xFD00
addf spindle-inhibit    servo-thread
addf spindle-tool-fault servo-thread
setp spindle-inhibit.function    0xFD
setp spindle-tool-fault.function 0xFD00
net io-din2-2           => spindle-inhibit.in-0 spindle-tool-fault.in-0
net io-din2-3           => spindle-inhibit.in-1 spindle-tool-fault.in-1
net drawbar-release-out => spindle-inhibit.in-2 spindle-tool-fault.in-2
net spindle-on          => spindle-tool-fault.in-3
net spindle-inhibit-out    <= spindle-inhibit.out    => spindle.0.inhibit
net spindle-tool-fault-out <= spindle-tool-fault.out => spindle.0.amp-fault-in

# VFD run direction (EL2808 #2 dout-2 / dout-3): spindle.0.forward is true for
# M3, spindle.0.reverse for M4; both false on M5. Speed comes from the EL4032
# (ethercat.hal). spindle.0.inhibit holds the speed at 0, but the VFD must not
# get a run signal either without a clamped tool, so each run signal is also
# gated with the tool clamp:
#
#   run = direction AND NOT spindle-inhibit-out (= tool clamped)
#
# lut5 function 0x2: out = in-0 AND NOT in-1 (true only for index 1).
# addf'd after spindle-inhibit so the gate sees the same cycle's clamp state.
addf spindle-cw-gate  servo-thread
addf spindle-ccw-gate servo-thread
setp spindle-cw-gate.function  0x2
setp spindle-ccw-gate.function 0x2
net spindle-forward     <= spindle.0.forward     => spindle-cw-gate.in-0
net spindle-reverse     <= spindle.0.reverse     => spindle-ccw-gate.in-0
net spindle-inhibit-out => spindle-cw-gate.in-1 spindle-ccw-gate.in-1
net spindle-cw  <= spindle-cw-gate.out  => lcec.0.io-dout2.dout-2   # VFD CW Clockwise
net spindle-ccw <= spindle-ccw-gate.out => lcec.0.io-dout2.dout-3   # VFD CCW Counter Clockwise

# Spindle at-speed wait: after M3/M4 (or an S change) motion holds the next
# feed move until spindle.0.at-speed. Rapids still run.
#   at-speed = din2-1 OR NOT spindle.0.on   (lut5 0xB; TRUE while off, so M5 doesn't wait)
addf spindle-at-speed servo-thread
setp spindle-at-speed.function 0xB
net io-din2-1            => spindle-at-speed.in-0
net spindle-on           => spindle-at-speed.in-1
net spindle-at-speed-out <= spindle-at-speed.out => spindle.0.at-speed

# dout-2 / dout-3: dust hood pneumatic solenoids (TRUE = push up / push down).
# The hood position is held in a flipflop (dust-hood): out = down solenoid,
# out-not = up solenoid, so exactly one is energised at any time — the hood
# is pushed up from the moment HAL starts until something lowers it.
# - M200 / M201 (remap/m200.ngc, m201.ngc) pulse motion.digital-out-01 /
#   -02 (M64, short dwell, M65) onto the flipflop's set / reset.
# - The PyVCP panel button (pyvcp.dust-hood-toggle, wired in postgui.hal)
#   clocks the flipflop with data = out-not, so every press toggles it. It
#   is pure HAL, so it works while a program is running.
# The M-codes only pulse, so they never block the button, and the button
# never confuses the M-codes: M200 always lowers, M201 always raises.
# - The "Dust hood keep up" checkbox (pyvcp.dust-hood-keep-up, postgui.hal)
#   holds reset via dust-hood-up-or; reset overrides set and clk, so while it
#   is ticked M200, M6 and the button can't lower the hood.
addf dust-hood       servo-thread
addf dust-hood-up-or servo-thread
net dust-hood-down-req <= motion.digital-out-01 => dust-hood.set
net dust-hood-up-req   <= motion.digital-out-02 => dust-hood-up-or.in0
net dust-hood-up-hold  <= dust-hood-up-or.out   => dust-hood.reset
net dust-hood-down     <= dust-hood.out     => lcec.0.io-dout3.dout-3 motion.digital-in-08   # Dust hood down (in-08: M6 saves/restores it)
net dust-hood-up       <= dust-hood.out-not => lcec.0.io-dout3.dout-2 dust-hood.data   # Dust hood up
# dout-4: blow nozzle (33Y6), wired with the flush air above.
# dout-6 / dout-7 and EL2808 #4: boring spindles, lowered by M6
# (remap/tc_aggregate_down.ngc) and raised again at the next M6. The common
# up valve is on while no horizontal aggregate is down:
# lut5 horizontal-up-valve, NOR(in-0, in-1) -> index 0 -> 0x1.
addf horizontal-up-valve servo-thread
setp horizontal-up-valve.function 0x1
net x-horizontal-down <= motion.digital-out-18 => lcec.0.io-dout3.dout-6 horizontal-up-valve.in-0   # X horizontal drill aggregate down (T201/T202)
net y-horizontal-down <= motion.digital-out-19 => lcec.0.io-dout4.dout-0 horizontal-up-valve.in-1   # Y horizontal drill aggregate down (T203/T204)
net horizontal-up     <= horizontal-up-valve.out => lcec.0.io-dout3.dout-7                         # horizontal drill aggregates all up

# --- EL2808 #4 (digital outputs, slave idx 14) ---
net vertical-1-down <= motion.digital-out-11 => lcec.0.io-dout4.dout-1   # 1st vertical drill spindle down (T101)
net vertical-2-down <= motion.digital-out-12 => lcec.0.io-dout4.dout-2   # 2nd vertical drill spindle down (T102)
net vertical-3-down <= motion.digital-out-13 => lcec.0.io-dout4.dout-3   # 3rd vertical drill spindle down (T103)
net vertical-4-down <= motion.digital-out-14 => lcec.0.io-dout4.dout-4   # 4th vertical drill spindle down (T104)
net vertical-5-down <= motion.digital-out-15 => lcec.0.io-dout4.dout-5   # 5th vertical drill spindle down (T105)
net vertical-6-down <= motion.digital-out-16 => lcec.0.io-dout4.dout-6   # 6th vertical drill spindle down (T106)
net vertical-7-down <= motion.digital-out-17 => lcec.0.io-dout4.dout-7   # 7th vertical drill spindle down (T107)

# --- EL4032 (2-ch analog output, spindle 0-10V — slave idx 15) ---
# Spindle speed wiring lives in ethercat.hal (net spindle-aout-cmd), since
# it's driven by spindle.0.speed-out-abs rather than a plain machine I/O net.
# Channel 1 (aout-1-*) is the terminal's second channel, unused here.

# --- Pendant jog: axis select dial + positive / negative buttons ---
# Jogs the selected axis (halui, world mode: only after homing, X moves both
# gantry motors) at [HALUI]JOG_SPEED while the button is held.
# One lut5 per axis and direction, in-0..3 = dial bits, in-4 = button:
#   dial code = din4-0 + 2*din4-1 + 4*din4-2 + 8*din4-3
#   function  = 1 << (16 + code)
# Codes are assumed as gray(position): X=1, Y=3, Z=2, spindle override (pos 7)
# = 4, jog speed (pos 8) = 12 — check with `halcmd show pin io-din4` per dial
# position and adjust the functions.
addf pendant-x-plus  servo-thread
addf pendant-x-minus servo-thread
addf pendant-y-plus  servo-thread
addf pendant-y-minus servo-thread
addf pendant-z-plus  servo-thread
addf pendant-z-minus servo-thread
setp pendant-x-plus.function  0x20000   # code 1
setp pendant-x-minus.function 0x20000
setp pendant-y-plus.function  0x80000   # code 3
setp pendant-y-minus.function 0x80000
setp pendant-z-plus.function  0x40000   # code 2
setp pendant-z-minus.function 0x40000
net io-din4-0 => pendant-x-plus.in-0 pendant-x-minus.in-0 pendant-y-plus.in-0 pendant-y-minus.in-0 pendant-z-plus.in-0 pendant-z-minus.in-0
net io-din4-1 => pendant-x-plus.in-1 pendant-x-minus.in-1 pendant-y-plus.in-1 pendant-y-minus.in-1 pendant-z-plus.in-1 pendant-z-minus.in-1
net io-din4-2 => pendant-x-plus.in-2 pendant-x-minus.in-2 pendant-y-plus.in-2 pendant-y-minus.in-2 pendant-z-plus.in-2 pendant-z-minus.in-2
net io-din4-3 => pendant-x-plus.in-3 pendant-x-minus.in-3 pendant-y-plus.in-3 pendant-y-minus.in-3 pendant-z-plus.in-3 pendant-z-minus.in-3
net io-din1-5 => pendant-x-plus.in-4  pendant-y-plus.in-4  pendant-z-plus.in-4
net io-din1-4 => pendant-x-minus.in-4 pendant-y-minus.in-4 pendant-z-minus.in-4
net pendant-x-plus  <= pendant-x-plus.out  => halui.axis.x.plus
net pendant-x-minus <= pendant-x-minus.out => halui.axis.x.minus
net pendant-y-plus  <= pendant-y-plus.out  => halui.axis.y.plus
net pendant-y-minus <= pendant-y-minus.out => halui.axis.y.minus
net pendant-z-plus  <= pendant-z-plus.out  => halui.axis.z.plus
net pendant-z-minus <= pendant-z-minus.out => halui.axis.z.minus

# Dial position 7: buttons step the spindle override by 5 %.
# Dial position 8: buttons step the jog speed: [HALUI]JOG_SPEED + count *
# JOG_SPEED_STEP, count -5..18 (500..12000 mm/min with 3000 / 500).
loadrt updown names=pendant-jog-count
loadrt scaled_s32_sums names=pendant-jog-speed
addf pendant-so-up       servo-thread
addf pendant-so-down     servo-thread
addf pendant-jog-up      servo-thread
addf pendant-jog-down    servo-thread
addf pendant-jog-count   servo-thread
addf pendant-jog-speed   servo-thread
setp pendant-so-up.function    0x100000     # code 4
setp pendant-so-down.function  0x100000
setp pendant-jog-up.function   0x10000000   # code 12
setp pendant-jog-down.function 0x10000000
net io-din4-0 => pendant-so-up.in-0 pendant-so-down.in-0 pendant-jog-up.in-0 pendant-jog-down.in-0
net io-din4-1 => pendant-so-up.in-1 pendant-so-down.in-1 pendant-jog-up.in-1 pendant-jog-down.in-1
net io-din4-2 => pendant-so-up.in-2 pendant-so-down.in-2 pendant-jog-up.in-2 pendant-jog-down.in-2
net io-din4-3 => pendant-so-up.in-3 pendant-so-down.in-3 pendant-jog-up.in-3 pendant-jog-down.in-3
net io-din1-5 => pendant-so-up.in-4   pendant-jog-up.in-4
net io-din1-4 => pendant-so-down.in-4 pendant-jog-down.in-4
setp halui.spindle.0.override.scale 0.05
net pendant-so-up   <= pendant-so-up.out   => halui.spindle.0.override.increase
net pendant-so-down <= pendant-so-down.out => halui.spindle.0.override.decrease
setp pendant-jog-count.clamp 1
setp pendant-jog-count.min -5
setp pendant-jog-count.max 18
net pendant-jog-up   <= pendant-jog-up.out   => pendant-jog-count.countup
net pendant-jog-down <= pendant-jog-down.out => pendant-jog-count.countdown
net pendant-jog-steps <= pendant-jog-count.count => pendant-jog-speed.in0
setp pendant-jog-speed.scale0 [HALUI]JOG_SPEED_STEP
setp pendant-jog-speed.in1 1
setp pendant-jog-speed.scale1 [HALUI]JOG_SPEED
net pendant-jog-speed <= pendant-jog-speed.out-f => halui.axis.jog-speed

# --- Tool changer (M6, remap/toolchange.ngc) ---
# Inputs for M66, machine-off request for faults the operator must clear.
# out-08 (tool change area / X limit) is wired in postgui.hal.
net io-din3-0        => motion.digital-in-02   # air pressure ok
net io-din2-2        => motion.digital-in-03   # tool present and clamped
net io-din2-3        => motion.digital-in-04   # tool released
net io-din2-5        => motion.digital-in-06   # X horizontal boring aggregate up
net io-din2-6        => motion.digital-in-07   # Y horizontal boring aggregate up
net all-homed        <= motion.is-all-homed => motion.digital-in-05
net tc-machine-off   <= motion.digital-out-09 => halui.machine.off
# T / built-in M6 handshakes: no hardware, M6 is remapped and sets the tool with M61
net tool-prepare-loop  iocontrol.0.tool-prepare => iocontrol.0.tool-prepared
net tool-change-loop   iocontrol.0.tool-change  => iocontrol.0.tool-changed
