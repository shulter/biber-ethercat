# Vantage 33M final config — Beckhoff EK1100 + terminal chain wiring
# (loaded after ethercat.hal, see [HAL] HALFILE in biber3ax.ini)
#
# EtherCAT chain order (see ethercat-conf.xml), after the 4 servo drives
# (x-left, x-right, y, z):
#   EK1100 -> EL1808 -> EL1808 -> EL1808 -> EL1808 -> EL2808 -> EL2808 -> EL1018
#          -> EL9110 -> EL2808 -> EL2808 -> EL4032
#
# Each EL1808 is 8 digital inputs (din-0..din-7, 3ms filter), the EL1018 is 8
# digital inputs (din-0..din-7, 10us — no input filtering, for fast signals
# like probe/index), each EL2808 is 8 digital outputs (dout-0..dout-7). Net
# names are placeholders — assign to actual machine signals (e-stop chain,
# door interlocks, vacuum, dust, tool change — see docs/retrofit-plan.md
# Phase 4) once wiring is known, except dout1-0 below which is wired to the
# machine-enable indicator.

# --- EL1808 #1 (digital inputs, slave idx 5) ---
net io-din1-0 <= lcec.0.io-din1.din-0   # pendant button for main spindle tool release (NO, TRUE = pressed) — see drawbar-release below
# net io-din1-1 <= lcec.0.io-din1.din-1   # pendant button for reset
# net io-din1-2 <= lcec.0.io-din1.din-2   # footswitch right
# net io-din1-3 <= lcec.0.io-din1.din-3   # footswitch left
# net io-din1-4 <= lcec.0.io-din1.din-4   # pendant button negative jog
# net io-din1-5 <= lcec.0.io-din1.din-5   # pendant button positive jog
# net io-din1-6 <= lcec.0.io-din1.din-6   # pendant button F1 TBD
# net io-din1-7 <= lcec.0.io-din1.din-7   # pendant button F2 TBD

# --- EL1808 #2 (digital inputs, slave idx 6) ---
# net io-din2-0 <= lcec.0.io-din2.din-0   # VFD not turning
# net io-din2-1 <= lcec.0.io-din2.din-1   # VFD spindle at speed
# net io-din2-2 <= lcec.0.io-din2.din-2   # HSK main spindle: tool clamped / drawbar up
# net io-din2-3 <= lcec.0.io-din2.din-3   # HSK main spindle: tool released / drawbar down
net io-din2-4 <= lcec.0.io-din2.din-4   # HSK spindle: not turning (back EMF measurement, TRUE = not turning) — see drawbar-release below
# net io-din2-5 <= lcec.0.io-din2.din-5   # X horizontal drill aggregate is up
# net io-din2-6 <= lcec.0.io-din2.din-6   # Y horizontal drill aggregate is up
# net io-din2-7 <= lcec.0.io-din2.din-7   # vacuum sensor, pressure ok

# --- EL1808 #3 (digital inputs, slave idx 7) ---
# net io-din3-0 <= lcec.0.io-din3.din-0   # Pneumatic air sensor, pressure ok
# net io-din3-1 <= lcec.0.io-din3.din-1   # Dust hood is at position 1
# net io-din3-2 <= lcec.0.io-din3.din-2   # Dust hood is at position 2
# net io-din3-3 <= lcec.0.io-din3.din-3   # TODO: assign
# net io-din3-4 <= lcec.0.io-din3.din-4   # TODO: assign
# net io-din3-5 <= lcec.0.io-din3.din-5   # TODO: assign
# net io-din3-6 <= lcec.0.io-din3.din-6   # TODO: assign
# net io-din3-7 <= lcec.0.io-din3.din-7   # TODO: assign

# --- EL1808 #4 (digital inputs, slave idx 8) ---
# net io-din4-0 <= lcec.0.io-din4.din-0   # pendant rotary dial grey-code bit 0
# net io-din4-1 <= lcec.0.io-din4.din-1   # pendant rotary dial grey-code bit 1
# net io-din4-2 <= lcec.0.io-din4.din-2   # pendant rotary dial grey-code bit 2
# net io-din4-3 <= lcec.0.io-din4.din-3   # pendant rotary dial grey-code bit 3
# net io-din4-4 <= lcec.0.io-din4.din-4   # TODO: assign
# net io-din4-5 <= lcec.0.io-din4.din-5   # TODO: assign
# net io-din4-6 <= lcec.0.io-din4.din-6   # TODO: assign
# net io-din4-7 <= lcec.0.io-din4.din-7   # TODO: assign

# --- EL2808 #1 (digital outputs, slave idx 9) ---
# dout-0: machine-enable indicator — energized while LinuxCNC is switched on
# (halui.machine.is-on). Drives an external "machine enabled" lamp/relay;
# it is not the interlock chain feeding iocontrol.0.emc-enable-in.
net machine-enable <= halui.machine.is-on => lcec.0.io-dout1.dout-0 # Machine Enable

# dout-1: Z axis holding brake. TRUE = brake coil energized = brake released.
# Released 1.3 s after Z's amp-enable-out goes true (machine on, F2), giving
# the servo time to power up and hold position first; engaged again
# immediately (off-delay 0) when the machine is switched off or faults.
# z-brake-delay is loaded with the other timedelay instances in ethercat.hal.
# Note: the drive-ready supervision (ethercat.hal) faults the machine off if
# the Z drive isn't operation-enabled within its on-delay (< 1.3 s), so the
# brake only ever releases on a drive that's already holding.
addf z-brake-delay servo-thread
setp z-brake-delay.on-delay  1.3
setp z-brake-delay.off-delay 0.0
net z-enable => z-brake-delay.in
net z-brake-release <= z-brake-delay.out => lcec.0.io-dout1.dout-1 # Z brake release

# net io-dout1-2 => lcec.0.io-dout1.dout-2   # Drill Aggregate Enable Contactor
# net io-dout1-3 => lcec.0.io-dout1.dout-3   # HSK Milling Spindle Enable Contactor
# net io-dout1-4 => lcec.0.io-dout1.dout-4   # Vacuum pump Enable Contactor
# net io-dout1-5 => lcec.0.io-dout1.dout-5   # VFD preset 1
# net io-dout1-6 => lcec.0.io-dout1.dout-6   # VFD preset 2
# net io-dout1-7 => lcec.0.io-dout1.dout-7   # HSK spindle flush air

# --- EL2808 #2 (digital outputs, slave idx 10) ---
# net io-dout2-0 => lcec.0.io-dout2.dout-0   # oil dispenser X axis rack and pinion
# net io-dout2-1 => lcec.0.io-dout2.dout-1   # Schmierung Blasluft
# net io-dout2-2 => lcec.0.io-dout2.dout-2   # VFD CW Clockwise
# net io-dout2-3 => lcec.0.io-dout2.dout-3   # VFD CCW Counter Clockwise
# net io-dout2-4 => lcec.0.io-dout2.dout-4   # vaccuum port left open
# net io-dout2-5 => lcec.0.io-dout2.dout-5   # vaccuum port left close
# net io-dout2-6 => lcec.0.io-dout2.dout-6   # vaccuum port right open
# net io-dout2-7 => lcec.0.io-dout2.dout-7   # vaccuum port right close

# --- EL1018 (fast digital inputs, 10us, slave idx 11) ---
# net io-din5-0 <= lcec.0.io-din5.din-0   # Tool height probe input

# Limit switches, din-1..din-4. Each axis homes onto its positive limit
# switch, so the X, Y and Z+ switches double as home switches
# (HOME_IGNORE_LIMITS = YES in the INI, search direction positive). X has one
# switch for the whole gantry, netted to both X joints (tandem homing,
# HOME_SEQUENCE -2). X and Y have no negative limit switch.
#
# Switch polarity (joint pins expect TRUE = tripped):
# - X is normally-closed — din is TRUE while the axis is clear, so it uses
#   lcec's built-in inverted pin din-1-not.
# - Y, Z+ and Z- are normally-open — din goes TRUE only when hit, so they're
#   netted straight to the joint pins.
# Check: with the machine clear of all switches, `halcmd show pin
# lcec.0.io-din5` should read din-1 TRUE and din-2..din-4 FALSE.
net x-pos-lim <= lcec.0.io-din5.din-1-not => joint.0.pos-lim-sw-in joint.0.home-sw-in   # X positive limit / home (NC)
net x-pos-lim                             => joint.1.pos-lim-sw-in joint.1.home-sw-in
net y-pos-lim <= lcec.0.io-din5.din-2 => joint.2.pos-lim-sw-in joint.2.home-sw-in   # Y positive limit / home (NO)
net z-pos-lim <= lcec.0.io-din5.din-3 => joint.3.pos-lim-sw-in joint.3.home-sw-in   # Z positive limit / home (NO)
net z-neg-lim <= lcec.0.io-din5.din-4 => joint.3.neg-lim-sw-in                      # Z negative limit (NO)

# net io-din5-5 <= lcec.0.io-din5.din-5   # TODO: assign
# net io-din5-6 <= lcec.0.io-din5.din-6   # TODO: assign
# net io-din5-7 <= lcec.0.io-din5.din-7   # TODO: assign

# --- EL9110 (E-bus power supply feed terminal, bus position 12) ---
# Refreshes E-bus power for the terminals downstream of it in the chain.
# Declared in ethercat-conf.xml as a generic slave (so it reaches OP and
# lcec.0.state-op can go true — see the comment there). Its single input,
# lcec.0.io-power.power-ok, reports 24V supply OK; not wired to anything yet.
# net io-power-ok <= lcec.0.io-power.power-ok

# --- EL2808 #3 (digital outputs, slave idx 13) ---
# net io-dout3-0 => lcec.0.io-dout3.dout-0   # Alle Anschläge hoch: Y0, Y1, rechts, links

# dout-1: HSK spindle drawbar — TRUE pushes the drawbar and releases the tool.
# Interlocked in HAL (lut5 drawbar-release, loaded in ethercat.hal):
#
#   release = (pendant button OR M250 request)
#             AND spindle not turning (din2-4)  AND NOT spindle.0.on
#
# - Pendant button (io-din1-0): release only while held.
# - M250 / M251 (remap/m250.ngc, m251.ngc): set / clear the release request
#   on motion.digital-out-00 (M64/M65 P0). M250 checks the same conditions
#   itself first and aborts the program if they aren't met; the HAL interlock
#   above enforces them again, and drops the release if the spindle is
#   switched on or starts turning.
# - M250 reads spindle state through motion.digital-in-00 (not turning) and
#   motion.digital-in-01 (spindle.0.on) with M66.
# lut5 index = in-0 + 2*in-1 + 4*in-2 + 8*in-3; true for in-3=0, in-2=1 and
# (in-0 or in-1) → indexes 5, 6, 7 → function 0xE0.
addf drawbar-release servo-thread
setp drawbar-release.function 0xE0
net io-din1-0             => drawbar-release.in-0
net drawbar-release-req   <= motion.digital-out-00 => drawbar-release.in-1
net io-din2-4             => drawbar-release.in-2 motion.digital-in-00
net spindle-on            => drawbar-release.in-3 motion.digital-in-01
net drawbar-release-out   <= drawbar-release.out   => lcec.0.io-dout3.dout-1   # HSK Spindle pull draw bar up, release tool
# net io-dout3-2 => lcec.0.io-dout3.dout-2   # Dust hood up
# net io-dout3-3 => lcec.0.io-dout3.dout-3   # Dust hood down
# net io-dout3-4 => lcec.0.io-dout3.dout-4   # Auflage rechts A1
# net io-dout3-5 => lcec.0.io-dout3.dout-5   # Auflage rechts A2
# net io-dout3-6 => lcec.0.io-dout3.dout-6   # X horizontal drill aggregate down
# net io-dout3-7 => lcec.0.io-dout3.dout-7   # horizontal drill aggregates all up

# --- EL2808 #4 (digital outputs, slave idx 14) ---
# net io-dout4-0 => lcec.0.io-dout4.dout-0   # Y horizontal drill aggregate down
# net io-dout4-1 => lcec.0.io-dout4.dout-1   # 1st vertical drill spindle down
# net io-dout4-2 => lcec.0.io-dout4.dout-2   # 2nd vertical drill spindle down
# net io-dout4-3 => lcec.0.io-dout4.dout-3   # 3rd vertical drill spindle down
# net io-dout4-4 => lcec.0.io-dout4.dout-4   # 4th vertical drill spindle down
# net io-dout4-5 => lcec.0.io-dout4.dout-5   # 5th vertical drill spindle down
# net io-dout4-6 => lcec.0.io-dout4.dout-6   # 6th vertical drill spindle down
# net io-dout4-7 => lcec.0.io-dout4.dout-7   # 7th vertical drill spindle down

# --- EL4032 (2-ch analog output, spindle 0-10V — slave idx 15) ---
# Spindle speed wiring lives in ethercat.hal (net spindle-voltage-cmd), since
# it's driven by spindle.0.speed-out-abs rather than a plain machine I/O net.
# Channel 1 (aout-1-*) is the terminal's second channel, unused here.
