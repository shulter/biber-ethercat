# Vantage 33M — postgui HAL: wiring for the PyVCP servo/spindle panel
# (panel.xml). Loaded via [HAL] POSTGUI_HALFILE, which runs after the AXIS
# GUI (and its PyVCP panel, component name "pyvcp") has started — the
# pyvcp.* pins created by the panel's widgets don't exist until then, so
# this can't live in ethercat.hal.
#
# Each realtime component (conv_s32_float, scale, abs) can only be loadrt'd
# once per HAL session, even with multiple named instances. The *-vel-scale
# instances are loaded+addf'd in ethercat.hal together with spindle-scale, so
# they are only setp'd/netted here.
#
# Servo load: drive monitor U40.07 (0x2040:08) "average load ratio", the
# drive's average torque in % of rated torque (its overload protection value),
# mapped as lcec.0.<name>.load-ratio in % (ethercat-conf.xml).
#
# 606Ch "velocity actual value" raw units are assumed to be encoder counts/s
# (device default, no SI velocity object configured). RPM = counts/s *
# 60/131072 (131072 counts/rev, 17-bit encoder — see docs/kinematics.md).
# Verify this against the A6/SV660N drive parameters; if the drive reports
# SI-scaled velocity instead, the *-vel-scale.gain values below are wrong.

loadrt conv_s32_float names=x-left-vel-conv,x-right-vel-conv,y-vel-conv,z-vel-conv
addf x-left-vel-conv     servo-thread
addf x-right-vel-conv    servo-thread
addf y-vel-conv          servo-thread
addf z-vel-conv          servo-thread

loadrt abs names=x-left-vel-abs,x-right-vel-abs,y-vel-abs,z-vel-abs
addf x-left-vel-abs  servo-thread
addf x-right-vel-abs servo-thread
addf y-vel-abs       servo-thread
addf z-vel-abs       servo-thread

# 60 / 131072 = 0.00045777 RPM per count/s
setp x-left-vel-scale.gain  0.00045777
setp x-right-vel-scale.gain 0.00045777
setp y-vel-scale.gain       0.00045777
setp z-vel-scale.gain       0.00045777

# --- Servo load (X left, X right, Y, Z — % of rated torque, average) ---
net x-left-load   <= lcec.0.x-left.load-ratio  => pyvcp.x-left-load
net x-right-load  <= lcec.0.x-right.load-ratio => pyvcp.x-right-load
net y-load        <= lcec.0.y.load-ratio       => pyvcp.y-load
net z-load        <= lcec.0.z.load-ratio       => pyvcp.z-load

# --- Speed (X left, X right, Y, Z — RPM, absolute value) ---
# actual-velocity is already netted to cia402 in ethercat.hal (a HAL pin can
# only belong to one signal), so tap the existing signal name here instead
# of re-sourcing lcec.0.<name>.actual-velocity.
net x-left-drv-act-vel  => x-left-vel-conv.in
net x-right-drv-act-vel => x-right-vel-conv.in
net y-drv-act-vel       => y-vel-conv.in
net z-drv-act-vel       => z-vel-conv.in

net x-left-vel-f   x-left-vel-conv.out  => x-left-vel-scale.in
net x-right-vel-f  x-right-vel-conv.out => x-right-vel-scale.in
net y-vel-f        y-vel-conv.out       => y-vel-scale.in
net z-vel-f        z-vel-conv.out       => z-vel-scale.in

net x-left-vel-rpm   x-left-vel-scale.out  => x-left-vel-abs.in
net x-right-vel-rpm  x-right-vel-scale.out => x-right-vel-abs.in
net y-vel-rpm        y-vel-scale.out       => y-vel-abs.in
net z-vel-rpm        z-vel-scale.out       => z-vel-abs.in

net x-left-rpm-abs   x-left-vel-abs.out  => pyvcp.x-left-rpm
net x-right-rpm-abs  x-right-vel-abs.out => pyvcp.x-right-rpm
net y-rpm-abs        y-vel-abs.out       => pyvcp.y-rpm
net z-rpm-abs        z-vel-abs.out       => pyvcp.z-rpm

# Spindle speed display — commanded speed (net declared in ethercat.hal from
# spindle.0.speed-out-abs), since this design has no spindle feedback device
# (open-loop 0-10V drive via EL4032). Taps the same net that feeds the
# EL4032 output in ethercat.hal rather than re-sourcing the pin.
net spindle-speed-cmd => pyvcp.spindle-speed

# Spindle turning LED — measured, from the HSK spindle's back-EMF standstill
# input (io-din2-4, inverted by the spindle-turning "not" in io.hal), so it
# also lights while the spindle coasts down after M5.
net spindle-turning => pyvcp.spindle-turning-led

# Spindle at speed LED — the VFD's at-speed input (io-din2-1), not
# spindle.0.at-speed, which is also TRUE while the spindle is off.
net io-din2-1 => pyvcp.spindle-at-speed-led

# Drawbar LEDs, straight from the HSK sensors (io.hal). Both off = drawbar up, no tool.
net io-din2-2 => pyvcp.tool-clamped-led   # tool present and clamped
net io-din2-3 => pyvcp.drawbar-down-led   # tool released

# Air pressure / vacuum ok LEDs, straight from the pressure switches (io.hal).
net io-din3-0 => pyvcp.air-ok-led
net io-din2-7 => pyvcp.vacuum-ok-led

# --- Dust hood toggle button + "down" LED ---
# The button clocks the dust-hood flipflop (loaded and wired in io.hal), so
# each press toggles the hood; works while a program runs, as it's pure HAL.
net dust-hood-toggle-btn pyvcp.dust-hood-toggle => dust-hood.clk
net dust-hood-down => pyvcp.dust-hood-down-led
# "Dust hood keep up" override: holds the flipflop reset (io.hal).
net dust-hood-keep-up <= pyvcp.dust-hood-keep-up => dust-hood-up-or.in1

# --- Vacuum pump toggle button + "on" LED ---
# ORed with the foot switches onto the vacuum-pump flipflop clk (io.hal);
# works with the machine off too.
net vacuum-pump-toggle-btn pyvcp.vacuum-pump-toggle => vacuum-pump-toggle.in-2
net vacuum-pump-on => pyvcp.vacuum-pump-on-led

# Tool change area (M221 / M220, remap/m221.ngc / m220.ngc): motion.digital-out-08 switches the
# X min limit from the work area ([AXIS_X]MIN_LIMIT) to
# [TOOLCHANGER]X_MIN_LIMIT. Here because the ini.* pins are created by
# milltask, which starts after the HALFILEs.
# The panel check button does the same by hand, e.g. to jog out after an abort.
loadrt mux2 names=tc-x-min-limit
addf tc-area-or     servo-thread
addf tc-x-min-limit servo-thread
setp tc-x-min-limit.in0 [AXIS_X]MIN_LIMIT
setp tc-x-min-limit.in1 [TOOLCHANGER]X_MIN_LIMIT
net tc-area       <= motion.digital-out-08 => tc-area-or.in0
net tc-area-check <= pyvcp.tc-area-check   => tc-area-or.in1
net tc-area-on    <= tc-area-or.out        => tc-x-min-limit.sel pyvcp.tc-area-led
net x-min-limit <= tc-x-min-limit.out => ini.0.min_limit ini.1.min_limit ini.x.min_limit
