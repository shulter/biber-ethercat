; M6 — tool change with the linear rack (positions in toolchanger.ini).
; Remapped in biber3ax.ini: REMAP = M6 modalgroup=6 ngc=toolchange
; Tool number = pocket number: T1..T20, T0 = unload only.
; Boring tools T101..T107 (vertical spindles 1-7), T201..T204 (horizontal,
; 201/202 X aggregate, 203/204 Y aggregate): the HSK spindle gets the dust seal
; dummy ([TOOLCHANGER]DUMMY_TOOL), the VFD switches to the boring motor and the spindle is lowered.
; Their X/Y/Z offsets to the HSK spindle are in tool.tbl.
; Ends with G43 for the new tool (G49 for T0). Modal state is saved with M70
; and restored with M72 before the G43 (M73 would undo it on return); M5 after
; M72 so a restored M3/M4 doesn't restart the spindle.
;
; HAL (io.hal, postgui.hal):
;   in-00 spindle not turning   in-02 air pressure ok   in-03 tool present and clamped
;   in-04 tool released         in-05 all joints homed      in-08 dust hood down
;   out-00 drawbar release      out-07 flush air
;   out-08 tool change area (m220.ngc / m221.ngc, cleared again by on_abort.ngc)
;   out-09 machine off (halui.machine.off)
;   out-10 boring motor (contactor + KEB set 2 instead of HSK + set 5)
;   out-11..19 boring spindles down (tc_aggregate_down.ngc), in-06/07 X/Y horizontal up
; M66 ... L0 also serves as a queue buster: everything before it has executed.

o<toolchange> sub

  ; preview / verify: only track the tool
  o10 if [#<_task> EQ 0]
    M61 Q#<_selected_tool>
    o<tc_tlo> call
    o<toolchange> return
  o10 endif

  o20 if [#<_selected_tool> EQ #<_current_tool>]
    o<tc_tlo> call
    o<toolchange> return
  o20 endif

  M70                 ; save modal state
  G21 G90 G94
  o<accel_rapid> call

  #<old>  = #<_current_tool>
  #<new>  = #<_selected_tool>
  #<off>  = #<_ini[TOOLCHANGER]X_OFFSET>
  #<zchk> = #<_ini[TOOLCHANGER]Z_CHECK>
  #<zrel> = #<_ini[TOOLCHANGER]RELEASE_Z>
  #<fz>   = #<_ini[TOOLCHANGER]FLUSH_Z>
  #<ztop> = #<_ini[AXIS_Z]MAX_LIMIT>
  F#<_ini[TOOLCHANGER]FEED>

  ; --- checks ---
  #<new_bore> = [[#<new> GE 101 AND #<new> LE 107] OR [#<new> GE 201 AND #<new> LE 204]]
  #<old_bore> = [[#<old> GE 101 AND #<old> LE 107] OR [#<old> GE 201 AND #<old> LE 204]]
  o30 if [[#<new> LT 0 OR #<new> GT 20] AND #<new_bore> EQ 0]
    (abort, Tool change: unknown tool - use T1..T20, T101..T107, T201..T204, T0 to unload)
  o30 endif
  o31 if [#<old> GT 20 AND #<old_bore> EQ 0]
    (abort, Tool change: loaded tool is not a rack tool - remove it by hand, then M61 Q0)
  o31 endif

  ; HSK spindle content: boring tools run with the dust seal dummy in it
  #<dummy> = #<_ini[TOOLCHANGER]DUMMY_TOOL>
  o37 if [#<old_bore>]
    #<old> = #<dummy>
  o37 endif
  #<hsk> = #<new>
  o38 if [#<new_bore>]
    #<hsk> = #<dummy>
  o38 endif

  M65 P9              ; reset the machine-off request

  M66 P5 L0
  o32 if [#5399 NE 1]
    (abort, Tool change: machine not homed)
  o32 endif

  M66 P2 L0
  o33 if [#5399 NE 1]
    (abort, Tool change: air pressure too low)
  o33 endif

  ; dust hood up for the change; put back at the end
  M66 P8 L0
  #<hood> = #5399
  o<m201> call
  o34 if [#<hood>]
    G4 P1             ; hood travel
  o34 endif

  M5                  ; stop the spindle, checked at the first pocket + X_OFFSET
  o<tc_aggregate_up> call [#<old_bore>]

  M66 P3 L0
  #<present> = #5399
  o35 if [#<old> EQ 0 AND #<present> EQ 1]
    (abort, Tool change: spindle holds a tool but none is loaded - remove it or set it with M61)
  o35 endif
  o36 if [#<old> GT 0 AND #<present> NE 1]
    (debug, Tool change: T#<old> is loaded but the spindle is empty - skipping deposit)
    #<old> = 0
    M61 Q0
    #3990 = 0
  o36 endif

  G53 G0 Z#<ztop>

  ; --- HSK change, skipped if the HSK tool stays (dummy between boring tools) ---
  o40 if [#<old> NE #<hsk>]
    ; --- enter the tool change area ---
    o<m221> call

    ; --- deposit the current tool into its pocket ---
    o100 if [#<old> GT 0]
      o<tc_pocket> call [#<old>]
      #<px> = #<_tc_x>
      #<py> = #<_tc_y>
      #<pz> = #<_tc_z>

      G53 G0 X[#<px> + #<off>] Y#<py>
      o<tc_spindle_stopped> call
      G53 G0 Z#<pz>
      G53 G1 X#<px>
      M64 P0            ; release (as M250)
      M66 P4 L3 Q3      ; wait up to 3 s for tool released
      #<ok> = [#5399 EQ 1]
      o110 if [#<ok>]
        G53 G1 Z[#<pz> + #<zrel>]
        M65 P0            ; drawbar up: tool present only if it came along
        M66 P4 L4 Q3      ; wait for drawbar up
        #<up> = [#5399 EQ 0]
        M66 P3 L3 Q1      ; tool present?
        #<ok> = [#<up> AND [#5399 EQ -1]]   ; drawbar up and tool gone
      o110 endif

      o120 if [#<ok> EQ 0]
        ; tool stuck: put it back, clamp, move out, machine off
        M65 P7
        G53 G1 Z#<pz>
        M65 P0
        M66 P3 L3 Q3
        G53 G1 X[#<px> + #<off>]
        (msg, Tool change: tool not released or stuck in spindle - machine off, operator must intervene)
        M64 P9
        M66 P0 L0
        (abort, Tool change: tool not released or stuck in spindle - machine off, operator must intervene)
      o120 endif
      M61 Q0            ; tool is in its pocket: spindle empty if aborted from here
      #3990 = 0

      M62 P7            ; flush air on with the next move
      G53 G0 Z[#<pz> + #<zrel> + #<fz>]
      M63 P7            ; flush air off for the rest of the lift
      G53 G0 Z#<ztop>
      G53 G0 X[#<px> + #<_ini[TOOLCHANGER]X_BACKOFF>]
    o100 endif

    ; --- pick the new tool ---
    o200 if [#<hsk> GT 0]
      o<tc_pocket> call [#<hsk>]
      #<px> = #<_tc_x>
      #<py> = #<_tc_y>
      #<pz> = #<_tc_z>

      G53 G0 X[#<px> + #<off>] Y#<py>
      o<tc_spindle_stopped> call
      G53 G0 X#<px>
      M64 P0            ; release
      M66 P4 L3 Q6      ; wait up to 6 s for tool released, then Z down
      o210 if [#5399 NE 1]
        M65 P7
        M65 P0
        (abort, Tool change: drawbar did not release at approach)
      o210 endif

      G53 G0 Z[#<pz> + #<fz>]
      M62 P7            ; flush air on for the last FLUSH_Z above the tool
      G53 G0 Z[#<pz> + #<zchk>]
      M63 P7            ; flush air off before seating: it keeps the tool from clamping
      G53 G1 Z#<pz>
      M65 P7
      M65 P0            ; clamp
      M66 P3 L3 Q3      ; wait for tool present and clamped
      #<ok> = [#5399 EQ 1]
      o220 if [#<ok> EQ 0]
        (msg, Tool change: new tool not clamped - machine off, operator must intervene)
        M64 P9
        M66 P0 L0
        (abort, Tool change: new tool not clamped - machine off, operator must intervene)
      o220 endif
      M61 Q#<hsk>       ; new tool clamped: shown even if aborted from here
      #3990 = #<hsk>

      G53 G1 X[#<px> + #<off>]
      G53 G0 Z#<ztop>
      G53 G0 X#<_ini[AXIS_X]MIN_LIMIT>
    o200 else
      G53 G0 X[#<_ini[AXIS_X]MIN_LIMIT> + 1]   ; T0: back inside the work area
    o200 endif

    ; --- back to the work area ---
    o<m220> call

  o40 endif

  ; --- motor: KEB set + contactor, only with the spindle stopped ---
  o<tc_spindle_stopped> call
  o300 if [#<new_bore>]
    M64 P10
  o300 else
    M65 P10
  o300 endif
  G4 P0.5             ; contactors switched before anything can start the motor
  o310 if [#<new_bore>]
    o<tc_aggregate_down> call [#<new>]
  o310 endif

  M61 Q#<new>
  #3990 = #<new>      ; persisted, restored at startup (startup.ngc)

  o320 if [#<hood>]
    o<m200> call      ; dust hood back down
  o320 endif

  o<accel_restore> call
  M72                ; restore modal state
  M5
  o<tc_tlo> call

o<toolchange> endsub
M2
