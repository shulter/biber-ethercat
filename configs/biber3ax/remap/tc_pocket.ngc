    #<_tc_y> = #<_ini[TOOLCHANGER]POCKET_7_Y>
    #<_tc_z> = #<_ini[TOOLCHANGER]POCKET_7_Z>
  o100 elseif [#1 EQ 8]
    #<_tc_x> = #<_ini[TOOLCHANGER]POCKET_8_X>
    #<_tc_y> = #<_ini[TOOLCHANGER]POCKET_8_Y>
    #<_tc_z> = #<_ini[TOOLCHANGER]POCKET_8_Z>
  o100 elseif [#1 EQ 9]
