; tc_pocket — look up pocket #1 in [TOOLCHANGER] (toolchanger.ini).
; Returns #<_tc_x>, #<_tc_y>, #<_tc_z> (machine coordinates).

o<tc_pocket> sub
  o100 if [#1 EQ 1]
    #<_tc_x> = #<_ini[TOOLCHANGER]POCKET_1_X>
    #<_tc_y> = #<_ini[TOOLCHANGER]POCKET_1_Y>
    #<_tc_z> = #<_ini[TOOLCHANGER]POCKET_1_Z>
