    #<_tc_y> = #<_ini[TOOLCHANGER]POCKET_10_Y>
    #<_tc_z> = #<_ini[TOOLCHANGER]POCKET_10_Z>
  o100 elseif [#1 EQ 11]
    #<_tc_x> = #<_ini[TOOLCHANGER]POCKET_11_X>
    #<_tc_y> = #<_ini[TOOLCHANGER]POCKET_11_Y>
    #<_tc_z> = #<_ini[TOOLCHANGER]POCKET_11_Z>
  o100 elseif [#1 EQ 12]
    #<_tc_x> = #<_ini[TOOLCHANGER]POCKET_12_X>
    #<_tc_y> = #<_ini[TOOLCHANGER]POCKET_12_Y>
    #<_tc_z> = #<_ini[TOOLCHANGER]POCKET_12_Z>
  o100 elseif [#1 EQ 13]
