; M241 — vacuum pump on, both zones active (left + right ports open).
; Remapped in biber3ax.ini: REMAP = M241 modalgroup=10 ngc=m241
; Vacuum outputs (io.hal): motion.digital-out-04 -> io-dout1.dout-4 pump,
; -05 -> io-dout2.dout-4 left port open, -06 -> io-dout2.dout-6 right port open.
; The close valves (dout2-5 left, dout2-7 right) follow as the inverse in HAL.
; M240 off, M241 both zones, M242 left only, M243 right only.

o<m241> sub
  M64 P5   ; open left port
  M64 P6   ; open right port
  M64 P4   ; pump on
o<m241> endsub
M2
