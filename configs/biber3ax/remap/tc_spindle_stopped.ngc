; tc_spindle_stopped — wait up to 10 s each for the HSK spindle (back-EMF "not
; turning", motion.digital-in-00) and the VFD output, which also covers the boring
; motor ("not turning", motion.digital-in-09), abort the tool change otherwise.

o<tc_spindle_stopped> sub
  M66 P0 L3 Q10
  o100 if [#5399 NE 1]
    (abort, Tool change: spindle still turning)
  o100 endif
  M66 P9 L3 Q10
  o110 if [#5399 NE 1]
    (abort, Tool change: VFD still turning - check the motor, or the din2-0 signal)
  o110 endif
o<tc_spindle_stopped> endsub
M2
