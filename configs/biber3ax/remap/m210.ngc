; M210 — measure the loaded tool's length on the tool height probe.
; Remapped in biber3ax.ini: REMAP = M210 modalgroup=10 ngc=m210
; Positions and feeds: [TOOLCHANGER]PROBE_* (toolchanger.ini), machine coordinates.
; Two stages: fast search, back off past the release point, slow measuring touch.
; Probe: lcec.0.io-din5.din-0 -> motion.probe-input (io.hal). Flush air: out-07.
; Tool length = trigger Z - PROBE_Z_REF, written with G10 L1 and applied with
; G43. Modal state is saved with M70 and restored with M72 before the G43
; (M73 would undo the G43 on return).
; G38 has no G53, so the probe target is shifted into the current coordinate
; system by #<dz> (all Z offsets, incl. tool length).

o<m210> sub

  ; preview / verify: nothing to do
  o10 if [#<_task> EQ 0]
    o<m210> return
  o10 endif

  M70                 ; save modal state
  G21 G90 G94 G40
  o<accel_rapid> call

  #<tool> = #<_current_tool>
  #<ztop> = #<_ini[AXIS_Z]MAX_LIMIT>
  #<xclr> = #<_ini[TOOLCHANGER]PROBE_X_CLEAR>
  #<zmin> = #<_ini[TOOLCHANGER]PROBE_Z_MIN>

  ; --- checks ---
  o20 if [#<tool> LE 0]
    (abort, M210: no tool loaded)
  o20 endif
  o21 if [#<tool> GT 100]
    (abort, M210: boring tool loaded - only HSK tools can be measured)
  o21 endif

  M66 P5 L0
  o30 if [#5399 NE 1]
    (abort, M210: machine not homed)
  o30 endif

  M5
  M66 P0 L3 Q30
  o40 if [#5399 NE 1]
    (abort, M210: spindle still turning)
  o40 endif

  ; --- to the probe ---
  G53 G0 Z#<ztop>
  o50 if [#<_abs_x> LT #<xclr>]
    G53 G0 X#<xclr>
  o50 endif
  G53 G0 X[#<_ini[TOOLCHANGER]PROBE_X> - 50] Y[#<_ini[TOOLCHANGER]PROBE_Y> + 100]
  G53 G0 Z#<_ini[TOOLCHANGER]PROBE_Z_START>

  ; --- quick air blast to clear the tool probe ---
  M64 P7
  G4P0.5
  M65 P7
  
  G53 G0 X#<_ini[TOOLCHANGER]PROBE_X> Y#<_ini[TOOLCHANGER]PROBE_Y>
  ; --- fast search ---
  #<dz> = [#<_z> - #<_abs_z>]
  F#<_ini[TOOLCHANGER]PROBE_FAST_FEED>
  G38.3 Z[#<zmin> + #<dz>]
  o60 if [#5070 NE 1]
    G53 G0 Z#<ztop>
    (abort, M210: probe not triggered - tool missing or broken)
  o60 endif

  ; --- back off until the switch releases, then BACKOFF more ---
  F#<_ini[TOOLCHANGER]PROBE_FEED>
  G38.5 Z[#5063 + #<_ini[TOOLCHANGER]PROBE_RELEASE_MAX>]
  o61 if [#5070 NE 1]
    G53 G0 Z#<ztop>
    (abort, M210: probe switch did not release)
  o61 endif
  G1 Z[#5063 + #<_ini[TOOLCHANGER]PROBE_BACKOFF>]

  ; --- measuring touch ---
  G38.3 Z[#<_z> - #<_ini[TOOLCHANGER]PROBE_SLOW_TRAVEL>]
  o62 if [#5070 NE 1]
    G53 G0 Z#<ztop>
    (abort, M210: probe not triggered on the slow touch)
  o62 endif
  #<ztrig> = [#5063 - #<dz>]

  #<len> = [#<ztrig> - #<_ini[TOOLCHANGER]PROBE_Z_REF>]
  G10 L1 P#<tool> Z#<len>
  (debug, M210: T#<tool> length #<len>)

  ; --- back out ---
  M65 P7
  G53 G0 Z#<ztop>
  G53 G0 X#<xclr>

  o<accel_restore> call
  M72                 ; restore modal state
  M5                  ; M72 may restore M3/M4
  G43

o<m210> endsub
M2
