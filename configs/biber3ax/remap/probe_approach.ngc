; probe_approach — start of the edge and skew cycles. The probe is parked above the stock,
; over it near the corner (e.g. X10 Y10 in from the bottom left), probe extended, G49.
; Touch the top, lift LIFT above it, go EDGE_CLEAR out past the edge (against the probe
; direction #2 along axis #1), drop to EDGE_DEPTH below the top.
; Sets globals #<_pz> (trigger Z at the top) and the start #<_psx> #<_psy> #<_psz>.

o<probe_approach> sub
  #<_psx> = #<_x>
  #<_psy> = #<_y>
  #<_psz> = #<_z>
  o<probe_top> call
  #<_pz> = #<_value>
  F#<_ini[PROBE]FAST_FEED>
  G1 Z[#<_pz> + #<_ini[PROBE]LIFT>]
  o10 if [#1 EQ 0]
    G1 X[#<_psx> - #2 * #<_ini[PROBE]EDGE_CLEAR>]
  o10 else
    G1 Y[#<_psy> - #2 * #<_ini[PROBE]EDGE_CLEAR>]
  o10 endif
  G1 Z[#<_pz> - #<_ini[PROBE]EDGE_DEPTH>]
o<probe_approach> endsub
M2
