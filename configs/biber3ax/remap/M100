#!/bin/bash
# M100 P<xy> [Q<z>] — max acceleration [mm/s²] of X/Y (P) and Z (Q, optional).
# Use M300 in programs: it adds the queue buster so the change applies right away.
# Missing/zero values are left unchanged.
# Jerk = acceleration x 25 (~40 ms ramp, S-curve planner); skipped on 2.9 (no jerk pins).
set_acc() {
    [ -n "$2" ] && awk "BEGIN{exit !($2 > 0)}" || return 0
    for p in $1; do
        halcmd setp "$p" "$2" || exit 1
        j=${p/max_acceleration/max_jerk}
        halcmd getp "$j" >/dev/null 2>&1 && { halcmd setp "$j" "$(awk "BEGIN{print $2 * 25}")" || exit 1; }
    done
}
# Path jerk cap = largest axis jerk
set_traj_jerk() {
    halcmd getp ini.traj_max_jerk >/dev/null 2>&1 || return 0
    halcmd setp ini.traj_max_jerk "$(for a in x y z; do halcmd getp ini.$a.max_jerk; done | sort -g | tail -1)"
}
set_acc "ini.0.max_acceleration ini.1.max_acceleration ini.2.max_acceleration ini.x.max_acceleration ini.y.max_acceleration" "$1"
set_acc "ini.3.max_acceleration ini.z.max_acceleration" "$2"
set_traj_jerk
exit 0
