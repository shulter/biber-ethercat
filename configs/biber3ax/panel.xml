<?xml version="1.0" encoding="UTF-8"?>
<!--
  Vantage 33M — PyVCP panel (AXIS, [DISPLAY] PYVCP), wired in postgui.hal.
  Servo load (average, % of rated torque) and speed (RPM), commanded spindle speed,
  spindle / drawbar / air / vacuum LEDs, vacuum pump and dust hood toggles, dust hood keep-up, tool change area.
  Bars: canvas_height < bar_height + 10 hides the min/max labels; the value
  is shown inside the bar.
-->
<pyvcp>

<table>
<tablesticky sticky="w"/>
<tablerow/>
<label><text>""</text></label>
<label><text>"Servo load %"</text></label>
<label><text>"Speed RPM"</text></label>

<tablerow/>
<label><text>"X L"</text></label>
<bar>
  <halpin>"x-left-load"</halpin>
  <min_>0</min_>
  <max_>200</max_>
  <canvas_width>96</canvas_width>
  <canvas_height>18</canvas_height>
  <bar_width>92</bar_width>
  <bar_height>16</bar_height>
  <format>"3.0f"</format>
</bar>
<bar>
  <halpin>"x-left-rpm"</halpin>
  <min_>0</min_>
  <max_>6000</max_>
  <canvas_width>96</canvas_width>
  <canvas_height>18</canvas_height>
  <bar_width>92</bar_width>
  <bar_height>16</bar_height>
  <format>"4.0f"</format>
</bar>

<tablerow/>
<label><text>"X R"</text></label>
<bar>
  <halpin>"x-right-load"</halpin>
  <min_>0</min_>
  <max_>200</max_>
  <canvas_width>96</canvas_width>
  <canvas_height>18</canvas_height>
  <bar_width>92</bar_width>
  <bar_height>16</bar_height>
  <format>"3.0f"</format>
</bar>
<bar>
  <halpin>"x-right-rpm"</halpin>
  <min_>0</min_>
  <max_>6000</max_>
  <canvas_width>96</canvas_width>
  <canvas_height>18</canvas_height>
  <bar_width>92</bar_width>
  <bar_height>16</bar_height>
  <format>"4.0f"</format>
</bar>

<tablerow/>
<label><text>"Y"</text></label>
<bar>
  <halpin>"y-load"</halpin>
  <min_>0</min_>
  <max_>200</max_>
  <canvas_width>96</canvas_width>
  <canvas_height>18</canvas_height>
  <bar_width>92</bar_width>
  <bar_height>16</bar_height>
  <format>"3.0f"</format>
</bar>
<bar>
  <halpin>"y-rpm"</halpin>
  <min_>0</min_>
  <max_>6000</max_>
  <canvas_width>96</canvas_width>
  <canvas_height>18</canvas_height>
  <bar_width>92</bar_width>
  <bar_height>16</bar_height>
  <format>"4.0f"</format>
</bar>

<tablerow/>
<label><text>"Z"</text></label>
<bar>
  <halpin>"z-load"</halpin>
  <min_>0</min_>
  <max_>200</max_>
  <canvas_width>96</canvas_width>
  <canvas_height>18</canvas_height>
  <bar_width>92</bar_width>
  <bar_height>16</bar_height>
  <format>"3.0f"</format>
</bar>
<bar>
  <halpin>"z-rpm"</halpin>
  <min_>0</min_>
  <max_>6000</max_>
  <canvas_width>96</canvas_width>
  <canvas_height>18</canvas_height>
  <bar_width>92</bar_width>
  <bar_height>16</bar_height>
  <format>"4.0f"</format>
</bar>

<tablerow/>
<label><text>"Spdl"</text></label>
<tablespan columns="2"/>
<bar>
  <halpin>"spindle-speed"</halpin>
  <min_>0</min_>
  <max_>24000</max_>
  <canvas_width>192</canvas_width>
  <canvas_height>18</canvas_height>
  <bar_width>188</bar_width>
  <bar_height>16</bar_height>
  <format>"5.0f"</format>
</bar>
</table>

<!-- status LEDs, then toggles: LED left, its text / button right; one per row -->
<table>
<tablesticky sticky="w"/>
<tablerow/>
<led>
  <halpin>"spindle-turning-led"</halpin>
  <size>14</size>
  <on_color>"green"</on_color>
  <off_color>"grey"</off_color>
</led>
<label><text>"Spindle turning"</text><padx>6</padx></label>
<tablerow/>
<led>
  <halpin>"spindle-at-speed-led"</halpin>
  <size>14</size>
  <on_color>"green"</on_color>
  <off_color>"grey"</off_color>
</led>
<label><text>"Spindle at speed"</text><padx>6</padx></label>
<tablerow/>
<led>
  <halpin>"tool-clamped-led"</halpin>
  <size>14</size>
  <on_color>"green"</on_color>
  <off_color>"grey"</off_color>
</led>
<label><text>"Tool clamped"</text><padx>6</padx></label>
<tablerow/>
<led>
  <halpin>"drawbar-down-led"</halpin>
  <size>14</size>
  <on_color>"yellow"</on_color>
  <off_color>"grey"</off_color>
</led>
<label><text>"Drawbar released"</text><padx>6</padx></label>
<tablerow/>
<led>
  <halpin>"air-ok-led"</halpin>
  <size>14</size>
  <on_color>"green"</on_color>
  <off_color>"red"</off_color>
</led>
<label><text>"Air pressure ok"</text><padx>6</padx></label>
<tablerow/>
<led>
  <halpin>"vacuum-ok-led"</halpin>
  <size>14</size>
  <on_color>"green"</on_color>
  <off_color>"red"</off_color>
</led>
<label><text>"Vacuum ok"</text><padx>6</padx></label>
<tablerow/>
<label><text>""</text></label>
<label><text>""</text></label>
<tablerow/>
<led>
  <halpin>"vacuum-pump-on-led"</halpin>
  <size>14</size>
  <on_color>"green"</on_color>
  <off_color>"grey"</off_color>
</led>
<button>
  <halpin>"vacuum-pump-toggle"</halpin>
  <text>"Vacuum pump"</text>
  <width>16</width>
</button>
<tablerow/>
<led>
  <halpin>"dust-hood-down-led"</halpin>
  <size>14</size>
  <on_color>"green"</on_color>
  <off_color>"grey"</off_color>
</led>
<button>
  <halpin>"dust-hood-toggle"</halpin>
  <text>"Dust hood down"</text>
  <width>16</width>
</button>
<tablerow/>
<label><text>""</text></label>
<checkbutton>
  <halpin>"dust-hood-keep-up"</halpin>
  <text>"Dust hood keep up"</text>
  <width>16</width>
  <anchor>"w"</anchor>
</checkbutton>
<tablerow/>
<led>
  <halpin>"tc-area-led"</halpin>
  <size>14</size>
  <on_color>"yellow"</on_color>
  <off_color>"grey"</off_color>
</led>
<checkbutton>
  <halpin>"tc-area-check"</halpin>
  <text>"Tool change area"</text>
  <width>16</width>
  <anchor>"w"</anchor>
</checkbutton>
<tablerow/>
<label><text>""</text></label>
<button>
  <halpin>"blow-nozzle"</halpin>
  <text>"Blow nozzle"</text>
  <width>16</width>
</button>
</table>

<!-- reg pins down sensors 1-6 (io.hal), one row, LED left of its number -->
<hbox>
<label><text>"Reg pins down"</text><padx>6</padx></label>
<led><halpin>"reg-pin-1-down-led"</halpin><size>14</size><on_color>"green"</on_color><off_color>"grey"</off_color></led>
<label><text>"1"</text><padx>4</padx></label>
<led><halpin>"reg-pin-2-down-led"</halpin><size>14</size><on_color>"green"</on_color><off_color>"grey"</off_color></led>
<label><text>"2"</text><padx>4</padx></label>
<led><halpin>"reg-pin-3-down-led"</halpin><size>14</size><on_color>"green"</on_color><off_color>"grey"</off_color></led>
<label><text>"3"</text><padx>4</padx></label>
<led><halpin>"reg-pin-4-down-led"</halpin><size>14</size><on_color>"green"</on_color><off_color>"grey"</off_color></led>
<label><text>"4"</text><padx>4</padx></label>
<led><halpin>"reg-pin-5-down-led"</halpin><size>14</size><on_color>"green"</on_color><off_color>"grey"</off_color></led>
<label><text>"5"</text><padx>4</padx></label>
<led><halpin>"reg-pin-6-down-led"</halpin><size>14</size><on_color>"green"</on_color><off_color>"grey"</off_color></led>
<label><text>"6"</text><padx>4</padx></label>
</hbox>

</pyvcp>
