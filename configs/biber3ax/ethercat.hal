# Vantage 33M final config — 4x A6 servo wiring (X gantry, Y, Z) + EL4032 spindle
# analog output. Machine digital I/O (Beckhoff EK1100 + EL1808/EL2808/EL1018
# terminals) is in io.hal, loaded after this file.
# Requires: lcec, cia402 HAL components

loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS

loadusr -W lcec_conf ethercat-conf.xml
loadrt lcec
loadrt cia402 count=4

addf lcec.read-all            servo-thread
addf cia402.0.read-all        servo-thread
addf cia402.1.read-all        servo-thread
addf cia402.2.read-all        servo-thread
addf cia402.3.read-all        servo-thread
addf motion-command-handler   servo-thread
addf motion-controller      servo-thread
addf cia402.0.write-all       servo-thread
addf cia402.1.write-all       servo-thread
addf cia402.2.write-all       servo-thread
addf cia402.3.write-all       servo-thread
addf lcec.write-all           servo-thread

# E-stop loop. In LinuxCNC 2.9, iocontrol's e-stop state is simply
# !iocontrol.0.emc-enable-in, and the GUI's e-stop toggle (F1) only drives
# iocontrol.0.user-enable-out — so user-enable-out MUST be part of what feeds
# emc-enable-in, or F1 has no effect (LinuxCNC sits in ESTOP_RESET as soon
# as emc-enable-in is true, and F1 can neither reset nor trigger e-stop).
#
#   emc-enable-in = user-enable-out (F1)  AND  lcec.0.state-op
#
# lcec.0.state-op is true only while every EtherCAT slave is in OP, so the
# e-stop can't be reset with the bus down, and a slave falling out of OP
# later drops LinuxCNC into e-stop. Add a safety-relay feedback input here
# (and3/and4) once it's wired to a Beckhoff DI.
# The physical emergency stop circuit is hardware-only and not controlled by
# LinuxCNC; this loop is just LinuxCNC's internal e-stop state (F1).
loadrt and2 names=estop-chain
addf estop-chain servo-thread
net ec-all-op         <= lcec.0.state-op             => estop-chain.in0
net estop-user-enable <= iocontrol.0.user-enable-out => estop-chain.in1
net estop-ok          <= estop-chain.out             => iocontrol.0.emc-enable-in

# Drive-ready supervision. cia402.N.drv-fault only reflects the drive's
# statusword fault bit. An A6 whose HV (main circuit) supply is off doesn't
# fault — it just never reaches CiA402 "operation enabled" — and it still
# shows OP on EtherCAT, so Machine On (F2) would succeed with dead drives.
# Each joint's amp-fault-in is therefore:
#
#   drv-fault  OR  (amp-enable-out AND NOT stat-op-enabled, for > 1 s)
#
# so if a drive isn't operation-enabled within 1 s of F2 (or drops out of it
# later, e.g. HV lost while running), LinuxCNC raises a joint amplifier fault
# and switches machine power off. The 1 s on-delay covers the normal CiA402
# enable sequence; raise <joint>-not-op-delay.on-delay if a drive takes longer.
# lut5 function 0x2: out = in-0 AND NOT in-1 (true only for index 1).
loadrt lut5      names=x-left-not-op,x-right-not-op,y-not-op,z-not-op
loadrt timedelay names=x-left-not-op-delay,x-right-not-op-delay,y-not-op-delay,z-not-op-delay
loadrt or2       names=x-left-fault-or,x-right-fault-or,y-fault-or,z-fault-or
addf x-left-not-op         servo-thread
addf x-right-not-op        servo-thread
addf y-not-op              servo-thread
addf z-not-op              servo-thread
addf x-left-not-op-delay   servo-thread
addf x-right-not-op-delay  servo-thread
addf y-not-op-delay        servo-thread
addf z-not-op-delay        servo-thread
addf x-left-fault-or       servo-thread
addf x-right-fault-or      servo-thread
addf y-fault-or            servo-thread
addf z-fault-or            servo-thread
setp x-left-not-op.function  0x2
setp x-right-not-op.function 0x2
setp y-not-op.function       0x2
setp z-not-op.function       0x2
setp x-left-not-op-delay.on-delay   1.0
setp x-right-not-op-delay.on-delay  1.0
setp y-not-op-delay.on-delay        1.0
setp z-not-op-delay.on-delay        1.0
setp x-left-not-op-delay.off-delay  0.0
setp x-right-not-op-delay.off-delay 0.0
setp y-not-op-delay.off-delay       0.0
setp z-not-op-delay.off-delay       0.0

# Spindle speed command — a core motion pin. Declared once here so both the
# EL4032 analog-out wiring below and the postgui.hal display panel link to the
# same net instead of each trying to source it from spindle.0.speed-out-abs.
net spindle-speed-cmd <= spindle.0.speed-out-abs

# --- X gantry left (joint 0) ---
setp cia402.0.csp-mode 1
setp cia402.0.pos-scale [JOINT_0]CIA402_POS_SCALE

net x-left-enable     <= joint.0.amp-enable-out => cia402.0.enable x-left-not-op.in-0
net x-left-op-enabled <= cia402.0.stat-op-enabled  => x-left-not-op.in-1
net x-left-not-op-raw <= x-left-not-op.out        => x-left-not-op-delay.in
net x-left-drv-fault  <= cia402.0.drv-fault        => x-left-fault-or.in0
net x-left-not-ready  <= x-left-not-op-delay.out   => x-left-fault-or.in1
net x-left-amp-fault  => joint.0.amp-fault-in   <= x-left-fault-or.out
net x-left-pos-cmd    <= joint.0.motor-pos-cmd  => cia402.0.pos-cmd
net x-left-pos-fb     => joint.0.motor-pos-fb   <= cia402.0.pos-fb

net x-left-statusword     lcec.0.x-left.status-word      => cia402.0.statusword
net x-left-opmode-display lcec.0.x-left.mode-display     => cia402.0.opmode-display
net x-left-drv-act-pos    lcec.0.x-left.actual-position  => cia402.0.drv-actual-position
net x-left-drv-act-vel    lcec.0.x-left.actual-velocity  => cia402.0.drv-actual-velocity

net x-left-controlword    cia402.0.controlword           => lcec.0.x-left.control-word
net x-left-opmode         cia402.0.opmode                => lcec.0.x-left.control-mode
net x-left-drv-target-pos cia402.0.drv-target-position   => lcec.0.x-left.target-position
net x-left-drv-target-vel cia402.0.drv-target-velocity   => lcec.0.x-left.target-velocity

# Home/limit switches are on the Beckhoff EL1018, not the drive DIs — wired
# to the joints in io.hal.

# --- X gantry right (joint 1) ---
setp cia402.1.csp-mode 1
setp cia402.1.pos-scale [JOINT_1]CIA402_POS_SCALE

net x-right-enable     <= joint.1.amp-enable-out => cia402.1.enable x-right-not-op.in-0
net x-right-op-enabled <= cia402.1.stat-op-enabled  => x-right-not-op.in-1
net x-right-not-op-raw <= x-right-not-op.out        => x-right-not-op-delay.in
net x-right-drv-fault  <= cia402.1.drv-fault        => x-right-fault-or.in0
net x-right-not-ready  <= x-right-not-op-delay.out  => x-right-fault-or.in1
net x-right-amp-fault  => joint.1.amp-fault-in   <= x-right-fault-or.out
net x-right-pos-cmd    <= joint.1.motor-pos-cmd  => cia402.1.pos-cmd
net x-right-pos-fb     => joint.1.motor-pos-fb   <= cia402.1.pos-fb

net x-right-statusword     lcec.0.x-right.status-word      => cia402.1.statusword
net x-right-opmode-display lcec.0.x-right.mode-display     => cia402.1.opmode-display
net x-right-drv-act-pos    lcec.0.x-right.actual-position  => cia402.1.drv-actual-position
net x-right-drv-act-vel    lcec.0.x-right.actual-velocity  => cia402.1.drv-actual-velocity

net x-right-controlword    cia402.1.controlword           => lcec.0.x-right.control-word
net x-right-opmode         cia402.1.opmode                => lcec.0.x-right.control-mode
net x-right-drv-target-pos cia402.1.drv-target-position   => lcec.0.x-right.target-position
net x-right-drv-target-vel cia402.1.drv-target-velocity   => lcec.0.x-right.target-velocity

# --- Y axis (single motor, ball screw via belt reduction) ---
setp cia402.2.csp-mode 1
setp cia402.2.pos-scale [JOINT_2]CIA402_POS_SCALE

net y-enable     <= joint.2.amp-enable-out => cia402.2.enable y-not-op.in-0
net y-op-enabled <= cia402.2.stat-op-enabled  => y-not-op.in-1
net y-not-op-raw <= y-not-op.out             => y-not-op-delay.in
net y-drv-fault  <= cia402.2.drv-fault        => y-fault-or.in0
net y-not-ready  <= y-not-op-delay.out        => y-fault-or.in1
net y-amp-fault  => joint.2.amp-fault-in   <= y-fault-or.out
net y-pos-cmd    <= joint.2.motor-pos-cmd  => cia402.2.pos-cmd
net y-pos-fb     => joint.2.motor-pos-fb   <= cia402.2.pos-fb

net y-statusword     lcec.0.y.status-word      => cia402.2.statusword
net y-opmode-display lcec.0.y.mode-display     => cia402.2.opmode-display
net y-drv-act-pos    lcec.0.y.actual-position  => cia402.2.drv-actual-position
net y-drv-act-vel    lcec.0.y.actual-velocity  => cia402.2.drv-actual-velocity

net y-controlword    cia402.2.controlword           => lcec.0.y.control-word
net y-opmode         cia402.2.opmode                => lcec.0.y.control-mode
net y-drv-target-pos cia402.2.drv-target-position   => lcec.0.y.target-position
net y-drv-target-vel cia402.2.drv-target-velocity   => lcec.0.y.target-velocity

# --- Z axis (direct ball screw) ---
setp cia402.3.csp-mode 1
setp cia402.3.pos-scale [JOINT_3]CIA402_POS_SCALE

net z-enable     <= joint.3.amp-enable-out => cia402.3.enable z-not-op.in-0
net z-op-enabled <= cia402.3.stat-op-enabled  => z-not-op.in-1
net z-not-op-raw <= z-not-op.out             => z-not-op-delay.in
net z-drv-fault  <= cia402.3.drv-fault        => z-fault-or.in0
net z-not-ready  <= z-not-op-delay.out        => z-fault-or.in1
net z-amp-fault  => joint.3.amp-fault-in   <= z-fault-or.out
net z-pos-cmd    <= joint.3.motor-pos-cmd  => cia402.3.pos-cmd
net z-pos-fb     => joint.3.motor-pos-fb   <= cia402.3.pos-fb

net z-statusword     lcec.0.z.status-word      => cia402.3.statusword
net z-opmode-display lcec.0.z.mode-display     => cia402.3.opmode-display
net z-drv-act-pos    lcec.0.z.actual-position  => cia402.3.drv-actual-position
net z-drv-act-vel    lcec.0.z.actual-velocity  => cia402.3.drv-actual-velocity

net z-controlword    cia402.3.controlword           => lcec.0.z.control-word
net z-opmode         cia402.3.opmode                => lcec.0.z.control-mode
net z-drv-target-pos cia402.3.drv-target-position   => lcec.0.z.target-position
net z-drv-target-vel cia402.3.drv-target-velocity   => lcec.0.z.target-velocity

# --- Spindle (Beckhoff EL4032, 0-10V analog out to VFD, 0-24000 RPM) ---
# EL4032 uses lcec's shared "aout" analog-output class, not a flat ao-N pin —
# confirmed via `strings lcec.so` on the bench machine (lcec_class_aout.c).
# The command pin is aout-0-value; aout-0-scale/-offset convert it to raw DAC
# counts internally but their exact units (volts directly, vs. a normalized
# +/-1.0 = full-scale fraction) aren't confirmed here — verify with a
# multimeter on the EL4032's output terminals before trusting the VFD sees
# the right voltage, and adjust spindle-scale.gain below (or the terminal's
# own aout-0-scale/-offset pins) to match. aout-0-enable must be true for the
# output to drive at all — gated here on spindle.0.on so it's 0V/disabled
# unless the spindle is actually commanded on.
# The "scale" RT component can only be loadrt'd once per HAL session, even
# for multiple named instances — so every scale instance needed anywhere in
# this config (here, plus the torque/speed display instances postgui.hal nets up
# once the GUI has loaded) is loaded together in this one call, in this file,
# since ethercat.hal loads first. postgui.hal only setp/nets these pins —
# loadrt or addf'ing "scale" again there would fail with "already exists" /
# "already in thread".
loadrt scale names=spindle-scale,x-left-torque-scale,x-right-torque-scale,y-torque-scale,z-torque-scale,x-left-vel-scale,x-right-vel-scale,y-vel-scale,z-vel-scale
addf spindle-scale        servo-thread
addf x-left-torque-scale  servo-thread
addf x-right-torque-scale servo-thread
addf y-torque-scale       servo-thread
addf z-torque-scale       servo-thread
addf x-left-vel-scale     servo-thread
addf x-right-vel-scale    servo-thread
addf y-vel-scale          servo-thread
addf z-vel-scale          servo-thread

# 10V / 24000 RPM = 0.00041667 V per RPM — ASSUMES aout-0-value takes volts
# directly (aout-0-scale/-offset left at their defaults). Verify on hardware.
setp spindle-scale.gain 0.00041667
setp spindle-scale.offset 0.0

net spindle-speed-cmd   => spindle-scale.in
net spindle-voltage-cmd <= spindle-scale.out => lcec.0.spindle.aout-0-value
net spindle-on          <= spindle.0.on       => lcec.0.spindle.aout-0-enable
