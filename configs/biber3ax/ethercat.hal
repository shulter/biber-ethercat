# Vantage 33M final config — 4x A6 servo wiring (X gantry, Y, Z) + spindle (commented out)
# Machine digital I/O (Beckhoff EK1100 terminals) is in io.hal, loaded after this file.
# Requires: lcec, cia402 HAL components

loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS

loadusr -W lcec_conf ethercat-conf.xml
loadrt lcec
loadrt cia402 count=4

addf lcec.read-all            servo-thread
addf cia402.0.read-all        servo-thread
addf cia402.1.read-all        servo-thread
addf cia402.2.read-all        servo-thread
addf cia402.3.read-all        servo-thread
addf motion-command-handler   servo-thread
addf motion-controller      servo-thread
addf cia402.0.write-all       servo-thread
addf cia402.1.write-all       servo-thread
addf cia402.2.write-all       servo-thread
addf cia402.3.write-all       servo-thread
addf lcec.write-all           servo-thread

setp iocontrol.0.emc-enable-in 1

# Spindle speed command — a core motion pin, present whether or not the EL4032
# is on the bus. Declared once here so both the (commented-out) EL4032
# analog-out wiring below and the postgui.hal display panel link to the same
# net instead of each trying to source it from spindle.0.speed-out-abs.
net spindle-speed-cmd <= spindle.0.speed-out-abs

# --- X gantry left (joint 0) ---
setp cia402.0.csp-mode 1
setp cia402.0.pos-scale [JOINT_0]CIA402_POS_SCALE

net x-left-enable     <= joint.0.amp-enable-out => cia402.0.enable
net x-left-amp-fault  => joint.0.amp-fault-in   <= cia402.0.drv-fault
net x-left-pos-cmd    <= joint.0.motor-pos-cmd  => cia402.0.pos-cmd
net x-left-pos-fb     => joint.0.motor-pos-fb   <= cia402.0.pos-fb

net x-left-statusword     lcec.0.x-left.status-word      => cia402.0.statusword
net x-left-opmode-display lcec.0.x-left.mode-display     => cia402.0.opmode-display
net x-left-drv-act-pos    lcec.0.x-left.actual-position  => cia402.0.drv-actual-position
net x-left-drv-act-vel    lcec.0.x-left.actual-velocity  => cia402.0.drv-actual-velocity

net x-left-controlword    cia402.0.controlword           => lcec.0.x-left.control-word
net x-left-opmode         cia402.0.opmode                => lcec.0.x-left.control-mode
net x-left-drv-target-pos cia402.0.drv-target-position   => lcec.0.x-left.target-position
net x-left-drv-target-vel cia402.0.drv-target-velocity   => lcec.0.x-left.target-velocity

# Home switch — wire to x-left drive DI; shared by both gantry joints
net x-home-sw => joint.0.home-sw-in <= lcec.0.x-left.home-switch

# --- X gantry right (joint 1) ---
setp cia402.1.csp-mode 1
setp cia402.1.pos-scale [JOINT_1]CIA402_POS_SCALE

net x-right-enable     <= joint.1.amp-enable-out => cia402.1.enable
net x-right-amp-fault  => joint.1.amp-fault-in   <= cia402.1.drv-fault
net x-right-pos-cmd    <= joint.1.motor-pos-cmd  => cia402.1.pos-cmd
net x-right-pos-fb     => joint.1.motor-pos-fb   <= cia402.1.pos-fb

net x-right-statusword     lcec.0.x-right.status-word      => cia402.1.statusword
net x-right-opmode-display lcec.0.x-right.mode-display     => cia402.1.opmode-display
net x-right-drv-act-pos    lcec.0.x-right.actual-position  => cia402.1.drv-actual-position
net x-right-drv-act-vel    lcec.0.x-right.actual-velocity  => cia402.1.drv-actual-velocity

net x-right-controlword    cia402.1.controlword           => lcec.0.x-right.control-word
net x-right-opmode         cia402.1.opmode                => lcec.0.x-right.control-mode
net x-right-drv-target-pos cia402.1.drv-target-position   => lcec.0.x-right.target-position
net x-right-drv-target-vel cia402.1.drv-target-velocity   => lcec.0.x-right.target-velocity

# Same home switch signal for tandem homing
net x-home-sw => joint.1.home-sw-in

# --- Y axis (single motor, ball screw via belt reduction) ---
setp cia402.2.csp-mode 1
setp cia402.2.pos-scale [JOINT_2]CIA402_POS_SCALE

net y-enable     <= joint.2.amp-enable-out => cia402.2.enable
net y-amp-fault  => joint.2.amp-fault-in   <= cia402.2.drv-fault
net y-pos-cmd    <= joint.2.motor-pos-cmd  => cia402.2.pos-cmd
net y-pos-fb     => joint.2.motor-pos-fb   <= cia402.2.pos-fb

net y-statusword     lcec.0.y.status-word      => cia402.2.statusword
net y-opmode-display lcec.0.y.mode-display     => cia402.2.opmode-display
net y-drv-act-pos    lcec.0.y.actual-position  => cia402.2.drv-actual-position
net y-drv-act-vel    lcec.0.y.actual-velocity  => cia402.2.drv-actual-velocity

net y-controlword    cia402.2.controlword           => lcec.0.y.control-word
net y-opmode         cia402.2.opmode                => lcec.0.y.control-mode
net y-drv-target-pos cia402.2.drv-target-position   => lcec.0.y.target-position
net y-drv-target-vel cia402.2.drv-target-velocity   => lcec.0.y.target-velocity

net y-home-sw => joint.2.home-sw-in <= lcec.0.y.home-switch

# --- Z axis (direct ball screw) ---
setp cia402.3.csp-mode 1
setp cia402.3.pos-scale [JOINT_3]CIA402_POS_SCALE

net z-enable     <= joint.3.amp-enable-out => cia402.3.enable
net z-amp-fault  => joint.3.amp-fault-in   <= cia402.3.drv-fault
net z-pos-cmd    <= joint.3.motor-pos-cmd  => cia402.3.pos-cmd
net z-pos-fb     => joint.3.motor-pos-fb   <= cia402.3.pos-fb

net z-statusword     lcec.0.z.status-word      => cia402.3.statusword
net z-opmode-display lcec.0.z.mode-display     => cia402.3.opmode-display
net z-drv-act-pos    lcec.0.z.actual-position  => cia402.3.drv-actual-position
net z-drv-act-vel    lcec.0.z.actual-velocity  => cia402.3.drv-actual-velocity

net z-controlword    cia402.3.controlword           => lcec.0.z.control-word
net z-opmode         cia402.3.opmode                => lcec.0.z.control-mode
net z-drv-target-pos cia402.3.drv-target-position   => lcec.0.z.target-position
net z-drv-target-vel cia402.3.drv-target-velocity   => lcec.0.z.target-velocity

net z-home-sw => joint.3.home-sw-in <= lcec.0.z.home-switch

# --- Spindle (Beckhoff EL4032, 0-10V analog out, 0-24000 RPM) ---
# Requires the EK1100 coupler chain (see ethercat-conf.xml) and the "spindle"
# slave (EL4032) to be on the bus. Uncomment once connected.
#
# loadrt scale names=spindle-scale
# addf spindle-scale servo-thread
#
# # 10V / 24000 RPM = 0.00041667 V per RPM
# setp spindle-scale.gain 0.00041667
# setp spindle-scale.offset 0.0
#
# net spindle-speed-cmd => spindle-scale.in
# net spindle-voltage-cmd <= spindle-scale.out => lcec.0.spindle.ao-0
# net spindle-on <= spindle.0.on
