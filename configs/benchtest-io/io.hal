# Vantage 33M bench I/O config — Beckhoff EK1100 + terminal chain wiring
# (loaded after ethercat.hal, see [HAL] HALFILE in benchtest-io.ini)
#
# EtherCAT chain order (see ethercat-conf.xml, confirmed via `sudo ethercat
# slaves`), after the 3 servo drives:
#   EK1100 -> EL1808 -> EL2808 -> EL1808 -> EL2808 -> EL9110 -> EL1808 -> EL2808
#          -> EL1808 -> EL2808 -> EL1018 -> EL4032
#
# Each EL1808 is 8 digital inputs (din-0..din-7, 3ms filter), the EL1018 is 8
# digital inputs (din-0..din-7, 10us — no input filtering, for fast signals
# like probe/index), each EL2808 is 8 digital outputs (dout-0..dout-7). Net
# names are placeholders — assign to actual machine signals (e-stop chain,
# door interlocks, vacuum, dust, tool change — see docs/retrofit-plan.md
# Phase 4) once wiring is known, except dout1-0 below which is wired to the
# machine-enable indicator.

# --- EL1808 #1 (digital inputs, slave idx 4) ---
# net io-din1-0 <= lcec.0.io-din1.din-0   # TODO: assign
# net io-din1-1 <= lcec.0.io-din1.din-1   # TODO: assign
# net io-din1-2 <= lcec.0.io-din1.din-2   # TODO: assign
# net io-din1-3 <= lcec.0.io-din1.din-3   # TODO: assign
# net io-din1-4 <= lcec.0.io-din1.din-4   # TODO: assign
# net io-din1-5 <= lcec.0.io-din1.din-5   # TODO: assign
# net io-din1-6 <= lcec.0.io-din1.din-6   # TODO: assign
# net io-din1-7 <= lcec.0.io-din1.din-7   # TODO: assign

# --- EL2808 #1 (digital outputs, slave idx 5) ---
# dout-0: machine-enable indicator — energized while LinuxCNC is switched on
# (halui.machine.is-on). Drives an external "machine enabled" lamp/relay;
# it is not the interlock chain feeding iocontrol.0.emc-enable-in.
net machine-enable <= halui.machine.is-on => lcec.0.io-dout1.dout-0

