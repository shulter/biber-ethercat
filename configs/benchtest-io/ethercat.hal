# Vantage 33M bench I/O config — dual-motor X gantry + single-motor Y, Z
# servos + EL4032 spindle analog output via EtherCAT. Digital I/O (Beckhoff
# EK1100 + EL1808/EL2808/EL9110 terminals) is wired in io.hal, loaded after
# this file.
# Requires: lcec, cia402 HAL components

loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS

loadusr -W lcec_conf ethercat-conf.xml
loadrt lcec
loadrt cia402 count=4

addf lcec.read-all            servo-thread
addf cia402.0.read-all        servo-thread
addf cia402.1.read-all        servo-thread
addf cia402.2.read-all        servo-thread
addf cia402.3.read-all        servo-thread
addf motion-command-handler   servo-thread
addf motion-controller      servo-thread
addf cia402.0.write-all       servo-thread
addf cia402.1.write-all       servo-thread
addf cia402.2.write-all       servo-thread
addf cia402.3.write-all       servo-thread
addf lcec.write-all           servo-thread

# Gate machine-enable on the EtherCAT master actually reaching OP state for
# all configured slaves. Previously this was `setp ... 1` (always true), so
# "Machine On" would succeed even with slaves stuck in INIT/PREOP/SAFEOP —
# cia402 would then be driven from stale/zero PDO data. lcec.0.state-op is a
# live bit, so this also drops the machine (like a fault) if a slave falls
# out of OP later, not just at startup.
# TODO verify pin name/semantics against your lcec version:
#   halcmd show pin | grep lcec.0.state
net ec-all-op <= lcec.0.state-op => iocontrol.0.emc-enable-in

# Spindle speed command — a core motion pin, present regardless of EtherCAT
# wiring. Declared once here so both the EL4032 analog-out wiring below and
# the postgui.hal display panel link to the same net instead of each trying
# to source it from spindle.0.speed-out-abs.
net spindle-speed-cmd <= spindle.0.speed-out-abs

# --- X axis, gantry left motor "x1" (joint 0) ---
setp cia402.0.csp-mode 1
setp cia402.0.pos-scale [JOINT_0]CIA402_POS_SCALE

net x1-enable     <= joint.0.amp-enable-out => cia402.0.enable
net x1-amp-fault  => joint.0.amp-fault-in   <= cia402.0.drv-fault
net x1-pos-cmd    <= joint.0.motor-pos-cmd  => cia402.0.pos-cmd
net x1-pos-fb     => joint.0.motor-pos-fb   <= cia402.0.pos-fb

net x1-statusword     lcec.0.x1.status-word      => cia402.0.statusword
net x1-opmode-display lcec.0.x1.mode-display     => cia402.0.opmode-display
net x1-drv-act-pos    lcec.0.x1.actual-position  => cia402.0.drv-actual-position
net x1-drv-act-vel    lcec.0.x1.actual-velocity  => cia402.0.drv-actual-velocity

net x1-controlword    cia402.0.controlword           => lcec.0.x1.control-word
net x1-opmode         cia402.0.opmode                => lcec.0.x1.control-mode
net x1-drv-target-pos cia402.0.drv-target-position   => lcec.0.x1.target-position
net x1-drv-target-vel cia402.0.drv-target-velocity   => lcec.0.x1.target-velocity

# Single physical gantry home switch, wired to x1's drive input only — netted
# to both joint 0 and joint 1 below (see docs/kinematics.md "Gantry Homing").
# x2's own home-switch PDO bit (ethercat-conf.xml) is left unwired.
net x-home-sw <= lcec.0.x1.home-switch => joint.0.home-sw-in => joint.1.home-sw-in

# --- X axis, gantry right motor "x2" (joint 1, tandem pair with x1) ---
setp cia402.1.csp-mode 1
setp cia402.1.pos-scale [JOINT_1]CIA402_POS_SCALE

net x2-enable     <= joint.1.amp-enable-out => cia402.1.enable
net x2-amp-fault  => joint.1.amp-fault-in   <= cia402.1.drv-fault
net x2-pos-cmd    <= joint.1.motor-pos-cmd  => cia402.1.pos-cmd
net x2-pos-fb     => joint.1.motor-pos-fb   <= cia402.1.pos-fb

net x2-statusword     lcec.0.x2.status-word      => cia402.1.statusword
net x2-opmode-display lcec.0.x2.mode-display     => cia402.1.opmode-display
net x2-drv-act-pos    lcec.0.x2.actual-position  => cia402.1.drv-actual-position
net x2-drv-act-vel    lcec.0.x2.actual-velocity  => cia402.1.drv-actual-velocity

net x2-controlword    cia402.1.controlword           => lcec.0.x2.control-word
net x2-opmode         cia402.1.opmode                => lcec.0.x2.control-mode
net x2-drv-target-pos cia402.1.drv-target-position   => lcec.0.x2.target-position
net x2-drv-target-vel cia402.1.drv-target-velocity   => lcec.0.x2.target-velocity

# --- Y axis (joint 2, ball screw via belt reduction) ---
setp cia402.2.csp-mode 1
setp cia402.2.pos-scale [JOINT_2]CIA402_POS_SCALE

net y-enable     <= joint.2.amp-enable-out => cia402.2.enable
net y-amp-fault  => joint.2.amp-fault-in   <= cia402.2.drv-fault
net y-pos-cmd    <= joint.2.motor-pos-cmd  => cia402.2.pos-cmd
net y-pos-fb     => joint.2.motor-pos-fb   <= cia402.2.pos-fb

net y-statusword     lcec.0.y.status-word      => cia402.2.statusword
net y-opmode-display lcec.0.y.mode-display     => cia402.2.opmode-display
net y-drv-act-pos    lcec.0.y.actual-position  => cia402.2.drv-actual-position
net y-drv-act-vel    lcec.0.y.actual-velocity  => cia402.2.drv-actual-velocity

net y-controlword    cia402.2.controlword           => lcec.0.y.control-word
net y-opmode         cia402.2.opmode                => lcec.0.y.control-mode
net y-drv-target-pos cia402.2.drv-target-position   => lcec.0.y.target-position
net y-drv-target-vel cia402.2.drv-target-velocity   => lcec.0.y.target-velocity

net y-home-sw => joint.2.home-sw-in <= lcec.0.y.home-switch

# --- Z axis (joint 3) ---
setp cia402.3.csp-mode 1
setp cia402.3.pos-scale [JOINT_3]CIA402_POS_SCALE

net z-enable     <= joint.3.amp-enable-out => cia402.3.enable
net z-amp-fault  => joint.3.amp-fault-in   <= cia402.3.drv-fault
net z-pos-cmd    <= joint.3.motor-pos-cmd  => cia402.3.pos-cmd
net z-pos-fb     => joint.3.motor-pos-fb   <= cia402.3.pos-fb

net z-statusword     lcec.0.z.status-word      => cia402.3.statusword
net z-opmode-display lcec.0.z.mode-display     => cia402.3.opmode-display
net z-drv-act-pos    lcec.0.z.actual-position  => cia402.3.drv-actual-position
net z-drv-act-vel    lcec.0.z.actual-velocity  => cia402.3.drv-actual-velocity

net z-controlword    cia402.3.controlword           => lcec.0.z.control-word
net z-opmode         cia402.3.opmode                => lcec.0.z.control-mode
net z-drv-target-pos cia402.3.drv-target-position   => lcec.0.z.target-position
net z-drv-target-vel cia402.3.drv-target-velocity   => lcec.0.z.target-velocity

net z-home-sw => joint.3.home-sw-in <= lcec.0.z.home-switch

# --- Spindle (Beckhoff EL4032, 0-10V analog out to VFD, 0-24000 RPM) ---
# EL4032 uses lcec's shared "aout" analog-output class, not a flat ao-N pin —
# confirmed via `strings lcec.so` on this machine (lcec_class_aout.c). The
# command pin is aout-0-value; aout-0-scale/-offset convert it to raw DAC
# counts internally but their exact units (volts directly, vs. a normalized
# +/-1.0 = full-scale fraction) aren't confirmed here — verify with a
# multimeter on the EL4032's output terminals before trusting the VFD sees
# the right voltage, and adjust spindle-scale.gain below (or the terminal's
# own aout-0-scale/-offset pins) to match. aout-0-enable must be true for the
# output to drive at all — gated here on spindle.0.on so it's 0V/disabled
# unless the spindle is actually commanded on.
# The "scale" RT component can only be loadrt'd once per HAL session, even
# for multiple named instances — so every scale instance needed anywhere in
# this config (here, plus the torque/velocity display instances postgui.hal
# nets up once the GUI has loaded) is loaded together in this one call, in
# this file, since ethercat.hal loads first. postgui.hal only setp/nets
# these pins — loadrt or addf'ing "scale" again there would fail with
# "already exists" / "already in thread".
loadrt scale names=spindle-scale,x1-torque-scale,x2-torque-scale,z-torque-scale,y-torque-scale,x1-vel-scale,x2-vel-scale,z-vel-scale,y-vel-scale
addf spindle-scale servo-thread
addf x1-torque-scale servo-thread
addf x2-torque-scale servo-thread
addf z-torque-scale servo-thread
addf y-torque-scale servo-thread
addf x1-vel-scale   servo-thread
addf x2-vel-scale   servo-thread
addf z-vel-scale    servo-thread
addf y-vel-scale    servo-thread

# 10V / 24000 RPM = 0.00041667 V per RPM — ASSUMES aout-0-value takes volts
# directly (aout-0-scale/-offset left at their defaults). Verify on hardware.
setp spindle-scale.gain 0.00041667
setp spindle-scale.offset 0.0

net spindle-speed-cmd   => spindle-scale.in
net spindle-voltage-cmd <= spindle-scale.out => lcec.0.spindle.aout-0-value
net spindle-on          <= spindle.0.on       => lcec.0.spindle.aout-0-enable
